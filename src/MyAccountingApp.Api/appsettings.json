{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Vault": {
    "Enabled": true
  },
  "CurrencyApi": {
    "Provider": "Frankfurter",
    "BaseUrl": "https://api.frankfurter.dev",
    "RequestsLimit": 100,
    "SafetyMargin": 10,
    "BackfillDaysOnFirstRun": 90,
    "MaxTimeseriesDays": 365,
    "ProviderName": "frankfurter"
  }
}
