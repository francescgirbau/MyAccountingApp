<MudTable Items="@Rows" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Class="mb-4" SortLabel="Sort by" TableClass="portfolio-table-compact">
    <ToolBarContent>
        <MudText Typo="Typo.subtitle1">Allocation by position</MudText>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<PortfolioPositionRowDto, object>(p => p.Symbol)">Symbol</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionRowDto, object>(p => p.Quantity)">Qty</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionRowDto, object>(p => p.Cost)">Cost</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionRowDto, object>(p => p.MarketValue ?? 0)">Mkt value</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionRowDto, object>(p => p.UnrealizedPnL ?? 0)">P&amp;L</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionRowDto, object>(p => p.UnrealizedPnLPct ?? 0)">P&amp;L %</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionRowDto, object>(p => p.PurchaseWeight ?? 0)">Purchase wt</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionRowDto, object>(p => p.CurrentWeight ?? 0)" InitialSortDirection="SortDirection.Descending">Current wt</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionRowDto, object>(p => p.WeightDelta ?? 0)">Δ wt</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right">Last price</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Symbol" Style="@PortfolioDisplay.HighlightStyle(HighlightedSymbol, context.Symbol)">
            <span class="cursor-pointer" @onclick="() => OnSelect.InvokeAsync(context.Symbol)">@context.Symbol</span>
        </MudTd>
        <MudTd DataLabel="Qty" Style="text-align: right">@context.Quantity.ToString("G")</MudTd>
        <MudTd DataLabel="Cost" Style="text-align: right">@context.Cost.ToString("N2") @context.Currency</MudTd>
        <MudTd DataLabel="Mkt value" Style="text-align: right">
            @if (context.MarketValue is not null)
            {
                <MudTooltip Placement="Placement.Top">
                    <ChildContent><span class="px-1">@context.MarketValue.Value.ToString("N2") @context.Currency</span></ChildContent>
                    <TooltipContent>
                        <span>@context.MarketValueEur?.ToString("N2") EUR
                            @(context.IsStale ? "(last close)" : string.Empty)</span>
                    </TooltipContent>
                </MudTooltip>
            }
            else
            {
                <span>—</span>
            }
        </MudTd>
        <MudTd DataLabel="P&amp;L" Style="text-align: right">
            <span class="@(context.UnrealizedPnL >= 0 ? "mud-success-text" : "mud-error-text")">
                @(context.UnrealizedPnL >= 0 ? "+" : "")@context.UnrealizedPnL?.ToString("N2")
            </span>
        </MudTd>
        <MudTd DataLabel="P&amp;L %" Style="text-align: right">
            @if (context.UnrealizedPnLPct is not null)
            {
                <span class="@(context.UnrealizedPnLPct >= 0 ? "mud-success-text" : "mud-error-text")">
                    @(context.UnrealizedPnLPct >= 0 ? "+" : "")@context.UnrealizedPnLPct.Value.ToString("P2")
                </span>
            }
            else
            {
                <span>—</span>
            }
        </MudTd>
        <MudTd DataLabel="Purchase wt" Style="text-align: right">@(context.PurchaseWeight?.ToString("P1") ?? "—")</MudTd>
        <MudTd DataLabel="Current wt" Style="text-align: right">@(context.CurrentWeight?.ToString("P1") ?? "—")</MudTd>
        <MudTd DataLabel="Δ wt" Style="text-align: right">
            @if (context.WeightDelta is not null)
            {
                <span class="@(context.WeightDelta >= 0 ? "mud-success-text" : "mud-error-text")">
                    @(context.WeightDelta >= 0 ? "+" : "")@context.WeightDelta.Value.ToString("P1")
                </span>
            }
            else
            {
                <span>—</span>
            }
        </MudTd>
        <MudTd DataLabel="Last price" Style="text-align: right">
            @(context.LastPrice?.ToString("N4") ?? "—")
            @if (context.IsStale)
            {
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" Class="ml-1" />
                    </ChildContent>
                    <TooltipContent><span>Market closed — last close price</span></TooltipContent>
                </MudTooltip>
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [Parameter] public IEnumerable<PortfolioPositionRowDto> Rows { get; set; } = Enumerable.Empty<PortfolioPositionRowDto>();
    [Parameter] public string? HighlightedSymbol { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
}