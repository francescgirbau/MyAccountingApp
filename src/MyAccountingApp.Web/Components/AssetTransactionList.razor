<MudTable Items="@Transactions" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Striped="true" SortLabel="Sort by"
          MultiSelection="true" @bind-SelectedItems="_selected">
    <ToolBarContent>
        <MudText Typo="Typo.subtitle1">@Transactions.Count transactions</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   OnClick="@(() => OnNew.InvokeAsync())" StartIcon="@Icons.Material.Filled.Add">
            New
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   OnClick="@(() => OnSplit.InvokeAsync())" StartIcon="@Icons.Material.Filled.CallSplit">
            Split / reverse split
        </MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="@(() => OnRefresh.InvokeAsync())" Size="Size.Small" />
    </ToolBarContent>
    <ColGroup>
        <col style="width: 120px" />
        <col style="width: 80px" />
        <col />
        <col style="width: 80px" />
        <col style="width: 90px" />
        <col style="width: 100px" />
        <col style="width: 80px" />
        <col style="width: 90px" />
        <col style="width: 150px" />
        <col style="width: 140px" />
    </ColGroup>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<AssetTransactionDto, object>(t => t.Transaction.Date)">Date</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<AssetTransactionDto, object>(t => t.Symbol)">Symbol</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<AssetTransactionDto, object>(t => t.Transaction.Description)">Description</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<AssetTransactionDto, object>(t => t.Quantity)">Qty</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<AssetTransactionDto, object>(t => t.UnitaryCost.Amount)">Unit price</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<AssetTransactionDto, object>(t => t.Transaction.Money.Amount)">@(SelectedType switch { "Buy" => "Cost", "Sell" => "Proceeds", _ => "Amount" })</MudTableSortLabel></MudTh>
        <MudTh>Curr.</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<AssetTransactionDto, object>(t => t.Type)">Type</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<AssetTransactionDto, object>(t => t.Transaction.Category)">Category</MudTableSortLabel></MudTh>
        <MudTh>Source</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Date">@context.Transaction.Date.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="Symbol">
            <MudTooltip Placement="Placement.Top">
                <ChildContent>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OnNavigateToPortfolio.InvokeAsync(context.Symbol))">@context.Symbol</MudChip>
                </ChildContent>
                <TooltipContent><span>Open position in Portfolio</span></TooltipContent>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="Description">@context.Transaction.Description</MudTd>
        <MudTd DataLabel="Qty">@context.Quantity.ToString("G")</MudTd>
        <MudTd DataLabel="Unit price">@context.UnitaryCost.Amount.ToString("N4")</MudTd>
        <MudTd DataLabel="Amount">@context.Transaction.Money.Amount.ToString("N2")</MudTd>
        <MudTd DataLabel="Curr.">@context.Transaction.Money.Currency</MudTd>
        <MudTd DataLabel="Type">@context.Type</MudTd>
        <MudTd DataLabel="Category">
            @{
                string label = AssetTransactionDisplay.GetCategoryLabel(context.Type, context.Transaction.Category);
                string tip = AssetTransactionDisplay.GetCategoryTooltip(context.Type, context.Transaction.Category);
            }
            @if (!string.IsNullOrEmpty(tip))
            {
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudChip T="string" Size="Size.Small" Color="@(context.Type == "Buy" ? Color.Primary : Color.Info)">@label</MudChip>
                    </ChildContent>
                    <TooltipContent><span>@tip · technical category: @context.Transaction.Category</span></TooltipContent>
                </MudTooltip>
            }
            else
            {
                <MudText Typo="Typo.caption">@context.Transaction.Category</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Source">
            @if (!string.IsNullOrEmpty(context.Source))
            {
                <MudText Typo="Typo.caption" Class="text-medium-emphasis">@context.Source</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption">—</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OnEdit.InvokeAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => OnDelete.InvokeAsync(context))" />
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new int[]{25, 50, 100})" />
    </PagerContent>
</MudTable>
<MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
    Amount is the cost basis for asset purchases and the proceeds for asset sales. Unit price is the amount per quantity.
</MudText>

@code {
    [Parameter] public IReadOnlyList<AssetTransactionDto> Transactions { get; set; } = new List<AssetTransactionDto>();
    [Parameter] public HashSet<AssetTransactionDto> Selected { get; set; } = new();
    [Parameter] public EventCallback<HashSet<AssetTransactionDto>> SelectedChanged { get; set; }
    [Parameter] public string? SelectedType { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback OnSplit { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<AssetTransactionDto> OnEdit { get; set; }
    [Parameter] public EventCallback<AssetTransactionDto> OnDelete { get; set; }
    [Parameter] public EventCallback<string> OnNavigateToPortfolio { get; set; }

    private HashSet<AssetTransactionDto> _selected
    {
        get => Selected;
        set => SelectedChanged.InvokeAsync(value);
    }
}