<MudDialog @bind-Visible="_dialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">New FX Conversion</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudDatePicker @bind-Date="_date" Label="Date" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_fromAmount" Label="From amount" Variant="Variant.Outlined" Min="@(0.01m)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_fromCurrency" Label="From currency" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("EUR")">EUR</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                    <MudSelectItem Value="@("GBP")">GBP</MudSelectItem>
                    <MudSelectItem Value="@("CHF")">CHF</MudSelectItem>
                    <MudSelectItem Value="@("CAD")">CAD</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_toAmount" Label="To amount" Variant="Variant.Outlined" Min="@(0.01m)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_toCurrency" Label="To currency" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("EUR")">EUR</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                    <MudSelectItem Value="@("GBP")">GBP</MudSelectItem>
                    <MudSelectItem Value="@("CHF")">CHF</MudSelectItem>
                    <MudSelectItem Value="@("CAD")">CAD</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudNumericField T="decimal?" @bind-Value="_rate" Label="Rate (quote per base, optional)" Variant="Variant.Outlined" Min="@(0.000001m)" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Close">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save" Disabled="@IsFormInvalid()">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public DateTime? InitialDate { get; set; }
    [Parameter] public EventCallback<FxConversionValue> SaveRequested { get; set; }

    private bool _snapshotted;
    private DateTime? _date;
    private decimal _fromAmount;
    private string _fromCurrency = "EUR";
    private decimal _toAmount;
    private string _toCurrency = "USD";
    private decimal? _rate;

    private bool _dialogVisible
    {
        get => Visible;
        set => VisibleChanged.InvokeAsync(value);
    }

    protected override void OnParametersSet()
    {
        if (Visible && !_snapshotted)
        {
            _snapshotted = true;
            _date = InitialDate ?? DateTime.Today;
            _fromAmount = 0;
            _fromCurrency = "EUR";
            _toAmount = 0;
            _toCurrency = "USD";
            _rate = null;
        }
        else if (!Visible)
        {
            _snapshotted = false;
        }
    }

    private bool IsFormInvalid() =>
        _fromAmount <= 0 ||
        _toAmount <= 0 ||
        string.IsNullOrWhiteSpace(_fromCurrency) ||
        string.IsNullOrWhiteSpace(_toCurrency) ||
        string.Equals(_fromCurrency, _toCurrency, StringComparison.OrdinalIgnoreCase) ||
        _rate is <= 0;

    private void Close() => _dialogVisible = false;

    private async Task Save()
    {
        await SaveRequested.InvokeAsync(new FxConversionValue(
            _date ?? DateTime.Today, _fromAmount, _fromCurrency, _toAmount, _toCurrency, _rate));
    }
}