<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center" Outlined="true" Height="100%">
            <MudText Typo="Typo.h6" GutterBottom="true">Allocation at purchase</MudText>
            <svg viewBox="0 0 200 200" width="220" height="220" aria-label="Allocation at purchase">
                @foreach (PortfolioPieSlice slice in PurchasePie)
                {
                    <path d="@slice.Path" fill="@slice.Color" stroke="var(--mud-palette-surface)" stroke-width="2"
                          class="@(slice.IsNavigable ? "cursor-pointer" : "")" @onclick="() => OnSelect.InvokeAsync(slice.Key)" />
                }
            </svg>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center" Outlined="true" Height="100%">
            <MudText Typo="Typo.h6" GutterBottom="true">Current allocation</MudText>
            <svg viewBox="0 0 200 200" width="220" height="220" aria-label="Current allocation">
                @foreach (PortfolioPieSlice slice in CurrentPie)
                {
                    <path d="@slice.Path" fill="@slice.Color" stroke="var(--mud-palette-surface)" stroke-width="2"
                          class="@(slice.IsNavigable ? "cursor-pointer" : "")" @onclick="() => OnSelect.InvokeAsync(slice.Key)" />
                }
            </svg>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Outlined="true" Height="100%">
            <MudText Typo="Typo.h6" GutterBottom="true">Legend</MudText>
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th></th>
                        <th>Symbol</th>
                        <th style="text-align: right">Value (EUR)</th>
                        <th style="text-align: right">Current wt</th>
                        <th style="text-align: right">Purchase wt</th>
                        <th style="text-align: right">P&amp;L %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (PortfolioLegendItem item in Legend)
                    {
                        <tr class="@(item.IsNavigable ? "cursor-pointer" : "")" @onclick="() => OnSelect.InvokeAsync(item.Key)">
                            <td><span class="rounded-lg mr-2" style="width: 14px; height: 14px; background-color: @item.Color; display: inline-block;"></span></td>
                            <td>@item.Key</td>
                            <td style="text-align: right">@item.ValueEur.ToString("N2") €</td>
                            <td style="text-align: right">@item.CurrentWeight.ToString("P1")</td>
                            <td style="text-align: right">
                                @if (item.PurchaseWeight is not null)
                                {
                                    <text>@item.PurchaseWeight.Value.ToString("P1") (@(item.WeightDelta >= 0 ? "+" : "")@item.WeightDelta.ToString("P1"))</text>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                            <td style="text-align: right">
                                @if (item.PnLPct is not null)
                                {
                                    <span class="@(item.PnLPct >= 0 ? "mud-success-text" : "mud-error-text")">@(item.PnLPct >= 0 ? "+" : "")@item.PnLPct.Value.ToString("P2")</span>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public IReadOnlyList<PortfolioPieSlice> PurchasePie { get; set; } = new List<PortfolioPieSlice>();
    [Parameter] public IReadOnlyList<PortfolioPieSlice> CurrentPie { get; set; } = new List<PortfolioPieSlice>();
    [Parameter] public IReadOnlyList<PortfolioLegendItem> Legend { get; set; } = new List<PortfolioLegendItem>();
    [Parameter] public EventCallback<string> OnSelect { get; set; }
}