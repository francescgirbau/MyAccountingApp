<MudDialog @bind-Visible="_dialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">@(Transaction is null ? "Add Option Transaction" : "Edit Option Transaction")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudDatePicker @bind-Date="_date" Label="Date" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_symbol" Label="Symbol" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_isin" Label="ISIN" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_quantity" Label="Quantity" Variant="Variant.Outlined" Min="@(0.01m)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_amount" Label="Amount" Variant="Variant.Outlined" Min="@(0.01m)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_currency" Label="Currency" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("EUR")">EUR</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                    <MudSelectItem Value="@("GBP")">GBP</MudSelectItem>
                    <MudSelectItem Value="@("CHF")">CHF</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_type" Label="Type" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Buy")">Buy</MudSelectItem>
                    <MudSelectItem Value="@("Sell")">Sell</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Close">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Save"
                   Disabled="@IsFormInvalid()">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public OptionTransactionDto? Transaction { get; set; }
    [Parameter] public EventCallback<OptionTransactionFormValue> SaveRequested { get; set; }

    private bool _snapshotted;
    private DateTime? _date;
    private string _description = "";
    private string _symbol = "";
    private string _isin = "";
    private decimal _quantity;
    private decimal _amount;
    private string _currency = "EUR";
    private string _type = "Buy";

    private bool _dialogVisible
    {
        get => Visible;
        set => VisibleChanged.InvokeAsync(value);
    }

    protected override void OnParametersSet()
    {
        if (Visible && !_snapshotted)
        {
            _snapshotted = true;
            if (Transaction is not null)
            {
                _date = Transaction.Transaction.Date;
                _description = Transaction.Transaction.Description;
                _symbol = Transaction.Symbol;
                _isin = Transaction.Isin;
                _quantity = Transaction.Quantity;
                _amount = Transaction.Transaction.Money.Amount;
                _currency = Transaction.Transaction.Money.Currency;
                _type = Transaction.Type;
            }
        }
        else if (!Visible)
        {
            _snapshotted = false;
        }
    }

    private bool IsFormInvalid() =>
        string.IsNullOrWhiteSpace(_description) ||
        string.IsNullOrWhiteSpace(_symbol) ||
        _amount <= 0 ||
        _quantity <= 0;

    private void Close() => _dialogVisible = false;

    private async Task Save() => await SaveRequested.InvokeAsync(new OptionTransactionFormValue(
        _date ?? DateTime.Today, _description, _amount, _currency, _symbol, _isin, _quantity, _type));
}
