<MudDialog @bind-Visible="_dialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Rebuild IBKR data</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>
            This removes the rows imported from Interactive Brokers statements for
            <strong>@string.Join(", ", SelectedYears)</strong>:
            @(Preview?.Transactions ?? 0) transactions, @(Preview?.Assets ?? 0) assets and
            @(Preview?.Options ?? 0) options (@(Preview?.OptionsWithoutSource ?? 0) of them without a
            recorded source). A backup is written first.
        </MudText>
        <MudText Typo="Typo.body2" Class="mt-3 mud-text-secondary">
            The backup file is saved under <strong>backups/</strong> before anything is removed. Other
            sources and manual entries are kept. After the rebuild is complete you must re-upload your
            Annual statements from the Import page.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Close">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@Confirm">Run rebuild</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }

    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public IReadOnlyList<int> SelectedYears { get; set; } = new List<int>();

    [Parameter] public IBKRRebuildPreviewDto? Preview { get; set; }

    [Parameter] public EventCallback ConfirmRequested { get; set; }

    private bool _dialogVisible
    {
        get => this.Visible;
        set => this.VisibleChanged.InvokeAsync(value);
    }

    private void Close() => this._dialogVisible = false;

    private async Task Confirm() => await this.ConfirmRequested.InvokeAsync();
}