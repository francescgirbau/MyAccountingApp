<MudTable Items="@Positions" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Striped="true" SortLabel="Sort by">
    <ToolBarContent>
        <MudText Typo="Typo.subtitle1">@Positions.Count positions</MudText>
    </ToolBarContent>
    <ColGroup>
        <col style="width: 90px" />
        <col style="width: 100px" />
        <col style="width: 110px" />
        <col style="width: 60px" />
        <col style="width: 100px" />
        <col style="width: 120px" />
        <col style="width: 120px" />
        <col style="width: 30px" />
    </ColGroup>
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<PortfolioPositionDto, object>(p => p.Symbol)">Symbol</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionDto, object>(p => p.NetQuantity)">Net Qty</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionDto, object>(p => p.AverageUnitaryCost)">Avg Cost</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionDto, object>(p => p.TotalCostBasis)">Total Cost</MudTableSortLabel></MudTh>
        <MudTh>Curr.</MudTh>
        <MudTh Style="text-align: right">Mkt Price</MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionDto, object>(p => p.UnrealizedGainLoss ?? 0)">Unrealized P&amp;L</MudTableSortLabel></MudTh>
        <MudTh Style="text-align: right"><MudTableSortLabel SortBy="new Func<PortfolioPositionDto, object>(p => p.RealizedGainLoss)">Realized P&amp;L</MudTableSortLabel></MudTh>
        @if (HasValuations)
        {
            <MudTh Style="text-align: right">
                <MudTooltip Placement="Placement.Top">
                    <ChildContent><span>Value in EUR (FX rate date in tooltip)</span></ChildContent>
                    <TooltipContent><span>Market value converted to EUR using the rate for the selected date</span></TooltipContent>
                </MudTooltip>
            </MudTh>
        }
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Symbol" Style="@PortfolioDisplay.HighlightStyle(HighlightedSymbol, context.Symbol)">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.Symbol</MudChip>
            @if (context.HasShortfall)
            {
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Error" Size="Size.Small" Class="ml-1" />
                    </ChildContent>
                    <TooltipContent>
                        <span>Sell shortfall: @context.UnmatchedSellQuantity.ToString("G") units sold without position</span>
                    </TooltipContent>
                </MudTooltip>
            }
            <MudIconButton Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" aria-label="View movements"
                           OnClick="@(() => OnViewMovements.InvokeAsync(context.Symbol))" />
        </MudTd>
        <MudTd DataLabel="Net Qty" Style="text-align: right">@context.NetQuantity.ToString("G")</MudTd>
        <MudTd DataLabel="Avg Cost" Style="text-align: right">@context.AverageUnitaryCost.ToString("N4")</MudTd>
        <MudTd DataLabel="Total Cost" Style="text-align: right">@context.TotalCostBasis.ToString("N2")</MudTd>
        <MudTd DataLabel="Curr.">@context.Currency</MudTd>
        <MudTd DataLabel="Mkt Price" Style="text-align: right">@(context.MarketPrice?.ToString("N4") ?? "—")</MudTd>
        <MudTd DataLabel="Unrealized P&amp;L" Style="text-align: right">
            @if (context.UnrealizedGainLoss is not null)
            {
                <span class="@(context.UnrealizedGainLoss >= 0 ? "mud-success-text" : "mud-error-text")">
                    @(context.UnrealizedGainLoss >= 0 ? "+" : "")@context.UnrealizedGainLoss?.ToString("N2")
                </span>
            }
            else
            {
                <span>—</span>
            }
        </MudTd>
        <MudTd DataLabel="Realized P&amp;L" Style="text-align: right">
            <span class="@(context.RealizedGainLoss >= 0 ? "mud-success-text" : "mud-error-text")">
                @(context.RealizedGainLoss >= 0 ? "+" : "")@context.RealizedGainLoss.ToString("N2")
            </span>
        </MudTd>
        @if (HasValuations)
        {
            <MudTd DataLabel="Value EUR" Style="text-align: right">
                @{ PositionValuationDto? val = ValuationLookup(context.Symbol); }
                @if (val?.ValueEur is not null)
                {
                    <MudTooltip Placement="Placement.Top">
                        <ChildContent>
                            <span class="px-1">@val.ValueEur.Value.ToString("N2") EUR</span>
                        </ChildContent>
                        <TooltipContent>
                            <span>@context.NetQuantity.ToString("G") × @(context.MarketPrice?.ToString("N4")) @context.Currency
                                × @(val.Rate?.ToString("N4")) (@(val.RateDate?.ToString("yyyy-MM-dd"))) = @val.ValueEur.Value.ToString("N2") EUR</span>
                        </TooltipContent>
                    </MudTooltip>
                    @if (val.IsStale)
                    {
                        <MudTooltip Placement="Placement.Top">
                            <ChildContent>
                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" Class="ml-1" />
                            </ChildContent>
                            <TooltipContent><span>Stale rate applied from @(val.RateDate?.ToString("yyyy-MM-dd"))</span></TooltipContent>
                        </MudTooltip>
                    }
                }
                else
                {
                    <span>—</span>
                }
            </MudTd>
        }
        <MudTd>
            <MudIconButton Icon="@(ExpandedSymbols.Contains(context.Symbol) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           OnClick="@(() => OnToggleExpanded.InvokeAsync(context))"
                           Size="Size.Small" />
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (ExpandedSymbols.Contains(context.Symbol))
        {
            <MudTd colspan="@(HasValuations ? 10 : 9)">
                <PortfolioOpenLots Lots="@context.OpenLots" />
            </MudTd>
        }
    </ChildRowContent>
    <FooterContent>
        <MudTFootRow>
            <MudTd>Totals</MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>
            <MudTd Style="text-align: right"><strong>@TotalCostBasis.ToString("N2")</strong></MudTd>
            <MudTd></MudTd>
            <MudTd></MudTd>
            <MudTd Style="text-align: right">
                @if (HasPrices)
                {
                    <strong class="@(TotalUnrealized >= 0 ? "mud-success-text" : "mud-error-text")">@(TotalUnrealized >= 0 ? "+" : "")@TotalUnrealized.ToString("N2")</strong>
                }
                else
                {
                    <strong>—</strong>
                }
            </MudTd>
            <MudTd Style="text-align: right">
                <strong class="@(TotalRealized >= 0 ? "mud-success-text" : "mud-error-text")">@(TotalRealized >= 0 ? "+" : "")@TotalRealized.ToString("N2")</strong>
            </MudTd>
            @if (HasValuations)
            {
                <MudTd Style="text-align: right">
                    <div><strong>@TotalValueEur.ToString("N2") €</strong></div>
                    <div class="mud-text-secondary">unrealized @(TotalUnrealizedEur >= 0 ? "+" : "")@TotalUnrealizedEur.ToString("N2") €</div>
                </MudTd>
            }
            <MudTd></MudTd>
        </MudTFootRow>
    </FooterContent>
</MudTable>

@code {
    [Parameter] public IReadOnlyList<PortfolioPositionDto> Positions { get; set; } = new List<PortfolioPositionDto>();
    [Parameter] public bool HasPrices { get; set; }
    [Parameter] public bool HasValuations { get; set; }
    [Parameter] public decimal TotalCostBasis { get; set; }
    [Parameter] public decimal TotalRealized { get; set; }
    [Parameter] public decimal TotalUnrealized { get; set; }
    [Parameter] public decimal TotalValueEur { get; set; }
    [Parameter] public decimal TotalUnrealizedEur { get; set; }
    [Parameter] public Func<string, PositionValuationDto?> ValuationLookup { get; set; } = static _ => null;
    [Parameter] public IReadOnlySet<string> ExpandedSymbols { get; set; } = new HashSet<string>();
    [Parameter] public string? HighlightedSymbol { get; set; }
    [Parameter] public EventCallback<string> OnViewMovements { get; set; }
    [Parameter] public EventCallback<PortfolioPositionDto> OnToggleExpanded { get; set; }
}