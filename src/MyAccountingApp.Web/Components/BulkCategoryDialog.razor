<MudDialog @bind-Visible="_dialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Change category</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            The new category will be applied to <strong>@SelectedCount</strong> selected transaction(s).
        </MudText>
        <MudSelect @bind-Value="_category" Label="New category" Variant="Variant.Outlined">
            @foreach (var cat in Categories)
            {
                <MudSelectItem Value="cat">@cat</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Close">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Confirm"
                   Disabled="@(string.IsNullOrWhiteSpace(_category))">
            Update @SelectedCount
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public int SelectedCount { get; set; }
    [Parameter] public IReadOnlyList<string> Categories { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string> ConfirmRequested { get; set; }

    private bool _snapshotted;
    private string _category = "";

    private bool _dialogVisible
    {
        get => Visible;
        set => VisibleChanged.InvokeAsync(value);
    }

    protected override void OnParametersSet()
    {
        if (Visible && !_snapshotted)
        {
            _snapshotted = true;
            _category = "";
        }
        else if (!Visible)
        {
            _snapshotted = false;
        }
    }

    private void Close() => _dialogVisible = false;

    private async Task Confirm() => await ConfirmRequested.InvokeAsync(_category);
}