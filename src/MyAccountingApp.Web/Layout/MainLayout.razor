@inherits LayoutComponentBase
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ThemeService ThemeService

<MudThemeProvider Theme="@ThemeService.Theme"
                  IsDarkMode="@_isDarkMode"
                  IsDarkModeChanged="@OnDarkModeChangedAsync"
                  ObserveSystemDarkModeChange="@ThemeService.FollowsSystem" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudAppBar>
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@((e) => _drawerOpen = !_drawerOpen)" />
            <MudText Typo="Typo.h6" Class="ml-2">MyAccountingApp</MudText>
            <MudSpacer />
            <MudMenu Icon="@ThemeIcon" Color="Color.Inherit" AriaLabel="Theme" Dense="true" Class="mr-2">
                <MudMenuItem Icon="@Icons.Material.Filled.BrightnessAuto" OnClick="@(() => SetThemeAsync(ThemePreference.System))">
                    System @ThemeCheck(ThemePreference.System)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.LightMode" OnClick="@(() => SetThemeAsync(ThemePreference.Light))">
                    Light @ThemeCheck(ThemePreference.Light)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.ModeNight" OnClick="@(() => SetThemeAsync(ThemePreference.Dark))">
                    Dark @ThemeCheck(ThemePreference.Dark)
                </MudMenuItem>
            </MudMenu>
        </MudAppBar>

        <div class="pa-6 mt-16">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;

    private string ThemeIcon => ThemeService.Preference switch
    {
        ThemePreference.Light => Icons.Material.Filled.LightMode,
        ThemePreference.Dark => Icons.Material.Filled.ModeNight,
        _ => Icons.Material.Filled.BrightnessAuto,
    };

    protected override async Task OnInitializedAsync()
    {
        await ThemeService.InitializeAsync();
        _isDarkMode = ThemeService.IsDarkMode;
        await this.CheckVaultStateAsync();
    }

    private async Task SetThemeAsync(ThemePreference preference)
    {
        await ThemeService.SetPreferenceAsync(preference);
        _isDarkMode = ThemeService.IsDarkMode;
    }

    // Raised by MudThemeProvider when the system colour scheme changes while we follow it.
    private async Task OnDarkModeChangedAsync(bool isDarkMode)
    {
        await ThemeService.OnSystemDarkModeChangedAsync(isDarkMode);
        _isDarkMode = ThemeService.IsDarkMode;
    }

    private MarkupString ThemeCheck(ThemePreference preference) =>
        ThemeService.Preference == preference
            ? new MarkupString("<span class=\"ml-2\">&check;</span>")
            : new MarkupString(string.Empty);

    private async Task CheckVaultStateAsync()
    {
        try
        {
            AuthStatusDto status = await Http.GetFromJsonAsync<AuthStatusDto>("/api/auth/status") ?? new AuthStatusDto();
            if (!status.IsEnabled)
            {
                return;
            }

            if (!status.IsInitialized)
            {
                if (!IsOnAuthPage("/setup"))
                {
                    Navigation.NavigateTo("/setup");
                }
            }
            else if (!status.IsUnlocked && !IsOnAuthPage("/unlock") && !IsOnAuthPage("/setup"))
            {
                Navigation.NavigateTo("/unlock");
            }
        }
        catch
        {
            // API unreachable: let the pages surface their own errors.
        }
    }

    private bool IsOnAuthPage(string page)
    {
        return Navigation.Uri.EndsWith(page, StringComparison.OrdinalIgnoreCase);
    }
}
