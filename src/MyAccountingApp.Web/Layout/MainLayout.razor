@inherits LayoutComponentBase
@inject HttpClient Http
@inject NavigationManager Navigation

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudAppBar>
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@((e) => _drawerOpen = !_drawerOpen)" />
            <MudText Typo="Typo.h6" Class="ml-2">MyAccountingApp</MudText>
        </MudAppBar>

        <div class="pa-6 mt-16">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    protected override async Task OnInitializedAsync()
    {
        await this.CheckVaultStateAsync();
    }

    private async Task CheckVaultStateAsync()
    {
        try
        {
            AuthStatusDto status = await Http.GetFromJsonAsync<AuthStatusDto>("/api/auth/status") ?? new AuthStatusDto();
            if (!status.IsEnabled)
            {
                return;
            }

            if (!status.IsInitialized)
            {
                if (!IsOnAuthPage("/setup"))
                {
                    Navigation.NavigateTo("/setup");
                }
            }
            else if (!status.IsUnlocked && !IsOnAuthPage("/unlock") && !IsOnAuthPage("/setup"))
            {
                Navigation.NavigateTo("/unlock");
            }
        }
        catch
        {
            // API unreachable: let the pages surface their own errors.
        }
    }

    private bool IsOnAuthPage(string page)
    {
        return Navigation.Uri.EndsWith(page, StringComparison.OrdinalIgnoreCase);
    }
}
