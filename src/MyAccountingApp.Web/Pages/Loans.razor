@page "/loans"
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Loans</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Loans</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <LoanList Loans="@_loans"
              OnNewLoan="@OpenNewLoanDialog"
              OnRefresh="@LoadDataAsync"
              OnAddRepayment="@OpenRepaymentDialog"
              OnCloseLoan="@CloseLoanAsync"
              OnDeleteLoan="@OpenDeleteDialog"
              OnEditMovement="@(t => OpenEditMovementDialog(t.Loan, t.Movement))"
              OnDeleteMovement="@(t => OpenDeleteMovementDialog(t.Loan, t.Movement))" />
}

<LoanFormDialog @bind-Visible="_showNewLoanDialog" OnSubmit="@CreateLoanAsync" />

<LoanRepaymentDialog @bind-Visible="_showRepaymentDialog"
                     Target="@_repaymentTarget"
                     OnSubmit="@AddRepaymentAsync" />

<LoanDeleteDialog @bind-Visible="_showDeleteDialog"
                  Target="@_deleteTarget"
                  OnConfirm="@DeleteLoanAsync" />

<LoanEditMovementDialog @bind-Visible="_showEditMovementDialog"
                        Loan="@_editMovementLoan"
                        Movement="@_editMovementTarget"
                        OnSubmit="@SaveEditMovementAsync" />

<LoanDeleteMovementDialog @bind-Visible="_showDeleteMovementDialog"
                          Loan="@_deleteMovementLoan"
                          Movement="@_deleteMovementTarget"
                          OnConfirm="@DeleteMovementAsync" />

@code {
    private List<LoanSummaryDto> _loans = new();
    private bool _loading = true;

    private bool _showNewLoanDialog;
    private bool _showRepaymentDialog;
    private bool _showDeleteDialog;
    private bool _showEditMovementDialog;
    private bool _showDeleteMovementDialog;

    private LoanSummaryDto? _repaymentTarget;
    private LoanSummaryDto? _deleteTarget;
    private LoanSummaryDto? _editMovementLoan;
    private LoanMovementDto? _editMovementTarget;
    private LoanSummaryDto? _deleteMovementLoan;
    private LoanMovementDto? _deleteMovementTarget;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _loans = await Http.GetFromJsonAsync<List<LoanSummaryDto>>("/api/loans") ?? new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenNewLoanDialog()
    {
        _showNewLoanDialog = true;
    }

    private async Task CreateLoanAsync(LoanFormValue value)
    {
        var payload = new
        {
            startDate = value.StartDate,
            counterparty = value.Counterparty.Trim(),
            amount = value.Amount,
            currency = value.Currency.Trim(),
            direction = value.Direction,
            notes = string.IsNullOrWhiteSpace(value.Notes) ? null : value.Notes.Trim(),
        };

        try
        {
            HttpResponseMessage response = await Http.PostAsJsonAsync("/api/loans", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Loan created", Severity.Success);
                _showNewLoanDialog = false;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add($"Failed to create loan: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating loan: {ex.Message}", Severity.Error);
        }
    }

    private void OpenRepaymentDialog(LoanSummaryDto loan)
    {
        _repaymentTarget = loan;
        _showRepaymentDialog = true;
    }

    private async Task AddRepaymentAsync(LoanRepaymentValue value)
    {
        if (_repaymentTarget is null)
        {
            return;
        }

        var payload = new
        {
            date = value.Date,
            amount = value.Amount,
            interestAmount = value.InterestAmount,
        };

        try
        {
            HttpResponseMessage response = await Http.PostAsJsonAsync($"/api/loans/{_repaymentTarget.LoanId}/repayments", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Repayment added", Severity.Success);
                _showRepaymentDialog = false;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add($"Failed to add repayment: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding repayment: {ex.Message}", Severity.Error);
        }
    }

    private async Task CloseLoanAsync(LoanSummaryDto loan)
    {
        try
        {
            HttpResponseMessage response = await Http.PatchAsync($"/api/loans/{loan.LoanId}/close", null);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Loan closed", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add($"Failed to close loan: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error closing loan: {ex.Message}", Severity.Error);
        }
    }

    private void OpenDeleteDialog(LoanSummaryDto loan)
    {
        _deleteTarget = loan;
        _showDeleteDialog = true;
    }

    private async Task DeleteLoanAsync(LoanSummaryDto loan)
    {
        try
        {
            HttpResponseMessage response = await Http.DeleteAsync($"/api/loans/{loan.LoanId}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Loan deleted", Severity.Success);
                _showDeleteDialog = false;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add($"Failed to delete loan: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting loan: {ex.Message}", Severity.Error);
        }
    }

    private void OpenEditMovementDialog(LoanSummaryDto loan, LoanMovementDto movement)
    {
        _editMovementLoan = loan;
        _editMovementTarget = movement;
        _showEditMovementDialog = true;
    }

    private async Task SaveEditMovementAsync(LoanMovementEditValue value)
    {
        var payload = new
        {
            date = value.Date,
            amount = value.Amount,
            type = value.Type,
        };

        try
        {
            HttpResponseMessage response = await Http.PatchAsJsonAsync($"/api/loans/{value.LoanId}/movements/{value.MovementId}", payload);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Movement updated", Severity.Success);
                _showEditMovementDialog = false;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add($"Failed to update movement: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating movement: {ex.Message}", Severity.Error);
        }
    }

    private void OpenDeleteMovementDialog(LoanSummaryDto loan, LoanMovementDto movement)
    {
        _deleteMovementLoan = loan;
        _deleteMovementTarget = movement;
        _showDeleteMovementDialog = true;
    }

    private async Task DeleteMovementAsync(LoanMovementTarget target)
    {
        try
        {
            HttpResponseMessage response = await Http.DeleteAsync($"/api/loans/{target.Loan.LoanId}/movements/{target.Movement.Id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Movement deleted", Severity.Success);
                _showDeleteMovementDialog = false;
                await LoadDataAsync();
            }
            else
            {
                Snackbar.Add($"Failed to delete movement: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting movement: {ex.Message}", Severity.Error);
        }
    }
}
