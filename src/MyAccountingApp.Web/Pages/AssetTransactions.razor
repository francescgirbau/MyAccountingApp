@page "/asset-transactions"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Asset Transactions</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Asset Transactions</MudText>

@if (_issueContext is not null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        <MudText Typo="Typo.body2" Class="d-inline">
            Showing <strong>@_filteredTransactions.Count</strong> impacted asset transaction(s) from Data Quality
            @if (!string.IsNullOrEmpty(IssueFromQuery))
            {
                <text>· @IssueFromQuery</text>
            }
        </MudText>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@ClearIssueFilter">Clear filter</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo("/data-quality"))">Back to Data Quality</MudButton>
    </MudAlert>
}

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_allTransactions.Count == 0)
{
    <MudPaper Class="pa-8 text-center" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Class="mud-text-secondary" />
        <MudText Typo="Typo.h5" Class="mt-4">No asset transactions yet</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">Import your first CSV or create an asset transaction manually.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload"
                   OnClick="@(() => Navigation.NavigateTo("import"))">
            Go to Import
        </MudButton>
    </MudPaper>
}
else
{
    <AssetTransactionFilters
        AvailableYears="@_availableYears"
        SelectedYear="@_selectedYear"
        SelectedYearChanged="@OnYearChanged"
        AvailableSymbols="@_availableSymbols"
        SelectedSymbol="@_selectedSymbol"
        SelectedSymbolChanged="@OnSymbolChanged"
        Types="@_types"
        SelectedType="@_selectedType"
        SelectedTypeChanged="@OnTypeChanged"
        AvailableCurrencies="@_availableCurrencies"
        SelectedCurrency="@_selectedCurrency"
        SelectedCurrencyChanged="@OnCurrencyChanged"
        SearchText="@_searchText"
        SearchTextChanged="@OnSearchChanged" />

    <AssetTransactionTotals Summaries="@_summaries" Count="@_filteredTransactions.Count" />

    @if (_selected.Count > 0)
    {
        <MudPaper Class="pa-2 mb-2 d-flex align-center" Outlined="true">
            <MudChip T="int" Color="Color.Primary" Size="Size.Small">@_selected.Count selected</MudChip>
            <MudText Typo="Typo.body2" Class="ml-2 mud-text-secondary">visible rows selected — bulk actions apply only to these</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       OnClick="@OpenBulkSymbolDialog" StartIcon="@Icons.Material.Filled.Edit">
                Change symbol
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@ClearSelection" Size="Size.Small" />
        </MudPaper>
    }

    <AssetTransactionList Transactions="@_filteredTransactions"
                          Selected="@_selected"
                          SelectedChanged="@OnSelectedChanged"
                          SelectedType="@_selectedType"
                          OnNew="@OpenCreateDialog"
                          OnSplit="@OpenSplitDialog"
                          OnRefresh="@LoadDataAsync"
                          OnEdit="@OpenEditDialog"
                          OnDelete="@OpenDeleteDialog"
                          OnNavigateToPortfolio="@NavigateToPortfolio" />
}

<AssetTransactionFormDialog @bind-Visible="_showFormDialog"
                            EditingId="@_editingId"
                            EditingTransaction="@_editingTransaction"
                            Categories="@_categories"
                            Types="@_types"
                            SaveRequested="@SaveAsync" />

<DeleteAssetTransactionDialog Visible="@_showDeleteDialog"
                              VisibleChanged="@OnDeleteDialogVisibleChanged"
                              Transaction="@_deletingTx"
                              ConfirmRequested="@ConfirmDeleteAsync" />

<BulkSymbolDialog @bind-Visible="_showBulkSymbolDialog"
                  SelectedCount="@_selected.Count"
                  ConfirmRequested="@ConfirmBulkSymbolAsync" />

<SplitAdjustmentDialog @bind-Visible="_showSplitDialog"
                       InitialSymbol="@_splitInitialSymbol"
                       Preview="@_splitPreview"
                       PreviewError="@_splitPreviewError"
                       PreviewLoading="@_splitPreviewLoading"
                       PreviewRequested="@PreviewSplitAsync"
                       ApplyRequested="@ApplySplitAsync" />

@code {
    private List<AssetTransactionDto> _allTransactions = new();
    private List<AssetTransactionDto> _filteredTransactions = new();
    private List<AssetTransactionSummary> _summaries = new();
    private List<int> _availableYears = new();
    private List<string> _availableSymbols = new();
    private List<string> _availableCurrencies = new();
    private bool _loading = true;

    private int? _selectedYear { get; set; }
    private string? _selectedSymbol { get; set; }
    private string? _selectedType { get; set; }
    private string? _selectedCurrency { get; set; }
    private string? _searchText { get; set; }

    private static readonly string[] _categories = { "INCOME", "EXPENSE", "TRANSFER", "DEPOSIT", "DIVIDEND", "FEE", "WITHHOLDING_TAX", "INTEREST", "INVESTMENT", "DIVESTMENT" };
    private static readonly string[] _types = { "Buy", "Sell" };

    private bool _showFormDialog;
    private bool _showDeleteDialog;
    private bool _showBulkSymbolDialog;
    private Guid? _editingId;
    private AssetTransactionDto? _editingTransaction;
    private AssetTransactionDto? _deletingTx;
    private HashSet<AssetTransactionDto> _selected = new();

    private bool _showSplitDialog;
    private string _splitInitialSymbol = "";
    private SplitAdjustmentPreview? _splitPreview;
    private string? _splitPreviewError;
    private bool _splitPreviewLoading;

    [SupplyParameterFromQuery(Name = "symbol")]
    public string? SymbolFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "year")]
    public int? YearFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "ids")]
    public string? IdsFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "issue")]
    public string? IssueFromQuery { get; set; }

    private List<Guid> _impactedIds = new();
    private string? _issueContext;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(SymbolFromQuery))
        {
            _selectedSymbol = SymbolFromQuery;
        }

        if (YearFromQuery.HasValue)
        {
            _selectedYear = YearFromQuery.Value;
        }

        if (!string.IsNullOrWhiteSpace(TypeFromQuery))
        {
            _selectedType = TypeFromQuery;
        }

        ApplyIssueFilterFromQuery();
        await LoadDataAsync();
    }

    private void NavigateToPortfolio(string symbol)
    {
        Navigation.NavigateTo($"/portfolio?symbol={Uri.EscapeDataString(symbol)}");
    }

    private void ApplyIssueFilterFromQuery()
    {
        this._impactedIds = new();
        this._issueContext = null;

        if (string.IsNullOrWhiteSpace(this.IdsFromQuery))
        {
            return;
        }

        List<Guid> ids = this.IdsFromQuery
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => Guid.TryParse(s, out Guid g) ? g : Guid.Empty)
            .Where(g => g != Guid.Empty)
            .ToList();

        if (ids.Count > 0)
        {
            this._impactedIds = ids;
            this._issueContext = string.IsNullOrWhiteSpace(this.IssueFromQuery) ? "impacted transactions" : this.IssueFromQuery;
        }
    }

    private void ClearIssueFilter()
    {
        this._impactedIds = new();
        this._issueContext = null;
        this._selected.Clear();
        this.ApplyFilters();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _allTransactions = await Http.GetFromJsonAsync<List<AssetTransactionDto>>("/api/asset-transactions") ?? new();
            _availableYears = _allTransactions
                .Select(t => t.Transaction.Date.Year)
                .Distinct()
                .OrderByDescending(y => y)
                .ToList();
            _availableSymbols = _allTransactions
                .Select(t => t.Symbol)
                .Distinct()
                .OrderBy(s => s)
                .ToList();
            _availableCurrencies = _allTransactions
                .Select(t => t.Transaction.Money.Currency)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Distinct()
                .OrderBy(c => c)
                .ToList();
            _selected.Clear();
            ApplyFilters();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnYearChanged(int? year)
    {
        _selectedYear = year;
        ApplyFilters();
    }

    private void OnSymbolChanged(string? symbol)
    {
        _selectedSymbol = symbol;
        ApplyFilters();
    }

    private void OnTypeChanged(string? type)
    {
        _selectedType = type;
        ApplyFilters();
    }

    private void OnCurrencyChanged(string? currency)
    {
        _selectedCurrency = currency;
        ApplyFilters();
    }

    private void OnSearchChanged(string? text)
    {
        _searchText = text;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = _allTransactions.AsEnumerable();

        if (_selectedYear.HasValue)
            query = query.Where(t => t.Transaction.Date.Year == _selectedYear.Value);

        if (!string.IsNullOrWhiteSpace(_selectedSymbol))
            query = query.Where(t => t.Symbol == _selectedSymbol);

        if (!string.IsNullOrWhiteSpace(_selectedType))
            query = query.Where(t => t.Type == _selectedType);

        if (!string.IsNullOrWhiteSpace(_selectedCurrency))
            query = query.Where(t => t.Transaction.Money.Currency == _selectedCurrency);

        if (!string.IsNullOrWhiteSpace(_searchText))
            query = query.Where(t => t.Transaction.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

        if (_impactedIds.Count > 0)
            query = query.Where(t => _impactedIds.Contains(t.Transaction.Id));

        _filteredTransactions = query.OrderByDescending(t => t.Transaction.Date).ToList();
        HashSet<Guid> filteredIds = _filteredTransactions.Select(t => t.Transaction.Id).ToHashSet();
        _selected.RemoveWhere(item => !filteredIds.Contains(item.Transaction.Id));

        if (_impactedIds.Count > 0 && _issueContext is not null)
        {
            foreach (AssetTransactionDto tx in _filteredTransactions.Where(t => _impactedIds.Contains(t.Transaction.Id)).Take(200))
            {
                _selected.Add(tx);
            }
        }

        RebuildSummaries();
    }

    private void RebuildSummaries()
    {
        _summaries = _filteredTransactions
            .GroupBy(t => string.IsNullOrWhiteSpace(t.Transaction.Money.Currency) ? "?" : t.Transaction.Money.Currency)
            .OrderBy(g => g.Key)
            .Select(g =>
            {
                List<AssetTransactionDto> buys = g.Where(t => t.Type == "Buy").ToList();
                List<AssetTransactionDto> sells = g.Where(t => t.Type == "Sell").ToList();
                decimal buyCost = buys.Sum(t => t.Transaction.Money.Amount);
                decimal sellProceeds = sells.Sum(t => t.Transaction.Money.Amount);
                decimal fees = g.Where(t => t.Transaction.Category is "FEE" or "WITHHOLDING_TAX").Sum(t => t.Transaction.Money.Amount);
                return new AssetTransactionSummary(
                    g.Key,
                    g.Count(),
                    buys.Count,
                    buyCost,
                    sells.Count,
                    sellProceeds,
                    fees,
                    sellProceeds - buyCost);
            })
            .ToList();
    }

    private void OpenCreateDialog()
    {
        _editingId = null;
        _editingTransaction = null;
        _showFormDialog = true;
    }

    private void OpenEditDialog(AssetTransactionDto atx)
    {
        _editingId = atx.Transaction.Id;
        _editingTransaction = atx;
        _showFormDialog = true;
    }

    private async Task SaveAsync(AssetTransactionFormValue value)
    {
        try
        {
            var payload = new
            {
                Date = value.Date,
                Description = value.Description,
                Amount = value.Amount,
                Currency = value.Currency,
                Category = value.Category,
                Symbol = value.Symbol,
                Quantity = value.Quantity,
                Type = value.Type,
            };

            HttpResponseMessage response;
            if (_editingId is null)
            {
                response = await Http.PostAsJsonAsync("/api/asset-transactions", payload);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"/api/asset-transactions/{_editingId}", payload);
            }

            if (response.IsSuccessStatusCode)
            {
                _showFormDialog = false;
                Snackbar.Add(_editingId is null ? "Asset transaction created" : "Asset transaction updated", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to save: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void ClearSelection()
    {
        _selected.Clear();
    }

    private static string Trim(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "no details";
        }

        return value.Length <= 200 ? value : value[..200] + "...";
    }

    private void OpenBulkSymbolDialog()
    {
        _showBulkSymbolDialog = true;
    }

    private async Task ConfirmBulkSymbolAsync(string symbol)
    {
        if (_selected.Count == 0 || string.IsNullOrWhiteSpace(symbol))
        {
            return;
        }

        List<AssetTransactionDto> targets = _selected.Where(s => _filteredTransactions.Any(f => f.Transaction.Id == s.Transaction.Id)).ToList();
        if (targets.Count == 0)
        {
            Snackbar.Add("No visible rows selected", Severity.Warning);
            return;
        }

        var payload = new
        {
            ids = targets.Select(t => t.Transaction.Id).ToList(),
            patch = new { symbol = symbol.Trim() },
        };

        try
        {
            HttpResponseMessage response = await Http.PatchAsJsonAsync("/api/asset-transactions/batch", payload);
            if (!response.IsSuccessStatusCode)
            {
                string body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Bulk update failed ({(int)response.StatusCode}): {Trim(body)}", Severity.Error);
                return;
            }

            BatchPatchResult? result = await response.Content.ReadFromJsonAsync<BatchPatchResult>();
            _showBulkSymbolDialog = false;
            _selected.Clear();

            if (result is null)
            {
                Snackbar.Add("Bulk update failed", Severity.Error);
            }
            else if (result.Failures.Count == 0)
            {
                Snackbar.Add($"{result.Updated} asset transaction(s) updated", Severity.Success);
            }
            else
            {
                string details = string.Join("; ", result.Failures.Select(f => f.Error));
                Snackbar.Add($"{result.Updated} updated, {result.Failures.Count} failed: {details}", Severity.Warning);
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenSplitDialog()
    {
        _splitInitialSymbol = _selectedSymbol ?? string.Empty;
        _splitPreview = null;
        _splitPreviewError = null;
        _showSplitDialog = true;
    }

    private async Task PreviewSplitAsync(SplitAdjustmentInput input)
    {
        _splitPreviewLoading = true;
        _splitPreviewError = null;
        try
        {
            var payload = new { symbol = input.Symbol, factor = input.Factor, asOfDate = input.AsOfDate };
            HttpResponseMessage response = await Http.PostAsJsonAsync("/api/asset-transactions/split/preview", payload);
            if (!response.IsSuccessStatusCode)
            {
                _splitPreviewError = await response.Content.ReadAsStringAsync();
                _splitPreview = null;
            }
            else
            {
                _splitPreview = await response.Content.ReadFromJsonAsync<SplitAdjustmentPreview>();
            }
        }
        catch (Exception ex)
        {
            _splitPreviewError = ex.Message;
            _splitPreview = null;
        }
        finally
        {
            _splitPreviewLoading = false;
        }
    }

    private async Task ApplySplitAsync(SplitAdjustmentInput input)
    {
        if (_splitPreview is null || _splitPreview.Items.Count == 0)
        {
            return;
        }

        try
        {
            var payload = new { symbol = input.Symbol, factor = input.Factor, asOfDate = input.AsOfDate };
            HttpResponseMessage response = await Http.PostAsJsonAsync("/api/asset-transactions/split", payload);
            if (!response.IsSuccessStatusCode)
            {
                string body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Split failed ({(int)response.StatusCode}): {Trim(body)}", Severity.Error);
                return;
            }

            BatchPatchResult? result = await response.Content.ReadFromJsonAsync<BatchPatchResult>();
            _showSplitDialog = false;

            if (result is null)
            {
                Snackbar.Add("Split applied", Severity.Success);
            }
            else if (result.Failures.Count == 0)
            {
                Snackbar.Add($"{result.Updated} lot(s) adjusted", Severity.Success);
            }
            else
            {
                string details = string.Join("; ", result.Failures.Select(f => f.Error));
                Snackbar.Add($"{result.Updated} adjusted, {result.Failures.Count} skipped: {details}", Severity.Warning);
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenDeleteDialog(AssetTransactionDto atx)
    {
        _deletingTx = atx;
        _showDeleteDialog = true;
    }

    private void OnDeleteDialogVisibleChanged(bool value)
    {
        _showDeleteDialog = value;
        if (!value)
        {
            _deletingTx = null;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deletingTx is null) return;

        try
        {
            HttpResponseMessage response = await Http.DeleteAsync($"/api/asset-transactions/{_deletingTx.Transaction.Id}");
            _showDeleteDialog = false;
            _deletingTx = null;

            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                Snackbar.Add("Asset transaction deleted", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to delete: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OnSelectedChanged(HashSet<AssetTransactionDto> value)
    {
        _selected = value;
    }
}