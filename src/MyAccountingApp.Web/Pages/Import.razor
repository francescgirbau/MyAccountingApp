@page "/import"
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Import</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Import Data</MudText>

<MudPaper Class="pa-6 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Upload a CSV file</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        Select a CSV file from your computer to import. Supported formats are detected automatically.
    </MudText>
    <MudGrid>
        <MudItem xs="12" sm="8">
            <InputFile OnChange="@OnFileSelected" accept=".csv" class="mud-input-outlined" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large"
                       OnClick="@UploadAndImportAsync" Disabled="@(_selectedFile is null || _loading)"
                       StartIcon="@Icons.Material.Filled.FileUpload"
                       FullWidth="true">
                Upload &amp; Import
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (_selectedFile is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">Selected: @_selectedFile.Name</MudText>
    }
</MudPaper>

<MudPaper Class="pa-6 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Import DeGiro / Flatex CSV</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        Upload a CSV exported from DeGiro or Flatex (Spanish format). Asset transactions, dividends, and fees are detected automatically.
    </MudText>
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
        <strong>Format detected automatically.</strong> Expected columns: Fecha, Hora, Fecha valor, Producto, ISIN, Descripción, Tipo, Variación, (amount), Saldo, (balance), ID Orden.<br />
        <strong>Compra</strong> / <strong>Venta</strong> rows become portfolio entries. <strong>Dividendo</strong>, <strong>Retención</strong> and <strong>Costes</strong> become cash transactions. Internal transfers are skipped.
    </MudAlert>
    <MudGrid>
        <MudItem xs="12" sm="8">
            <InputFile OnChange="@OnDegiroFileSelected" accept=".csv" class="mud-input-outlined" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large"
                       OnClick="@UploadDegiroAsync" Disabled="@(_degiroFile is null || _loading)"
                       StartIcon="@Icons.Material.Filled.FileUpload"
                       FullWidth="true">
                Import DeGiro
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (_degiroFile is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">Selected: @_degiroFile.Name</MudText>
    }
</MudPaper>

<MudPaper Class="pa-6 mb-4" Outlined="true">
    <MudText Typo="Typo.h6" GutterBottom="true">Import Raw CSV</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        Upload a CSV with your own format. No transformations applied.
    </MudText>
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
        <strong>Format:</strong> Date,Description,Amount,Type,Currency (Type: Income, Expense, Transfer, Deposit; Currency optional, defaults to EUR)
    </MudAlert>
    <MudGrid>
        <MudItem xs="12" sm="8">
            <InputFile OnChange="@OnRawFileSelected" accept=".csv" class="mud-input-outlined" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       OnClick="@UploadRawCsvAsync" Disabled="@(_rawFile is null || _loading)"
                       StartIcon="@Icons.Material.Filled.FileUpload"
                       FullWidth="true">
                Import Raw CSV
            </MudButton>
        </MudItem>
    </MudGrid>
    @if (_rawFile is not null)
    {
        <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">Selected: @_rawFile.Name</MudText>
    }
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}

@if (_result is not null)
{
    <MudAlert Severity="@(_result.Errors.Count == 0 ? Severity.Success : Severity.Warning)" Class="mb-4">
        <MudText>Import completed: <strong>@_result.FilesProcessed</strong> files processed,
            <strong>@_result.Transactions.Count</strong> transactions,
            <strong>@_result.AssetTransactions.Count</strong> asset transactions.
            @if (_result.Errors.Count > 0) { <span><strong>@_result.Errors.Count</strong> errors.</span> }
        </MudText>
    </MudAlert>

    @if (_result.AssetTransactions.Count > 0 && _showAssetTable)
    {
        <MudText Typo="Typo.subtitle1" GutterBottom="true">Asset Transactions</MudText>
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            Verify the detected symbols. Incorrect symbols can be edited later in the Portfolio page.
        </MudAlert>
        <MudSimpleTable Class="mb-4" Outlined="true" Hover="true">
            <thead>
                <tr><th>Symbol</th><th>Description</th><th>Amount</th><th>Currency</th><th>Quantity</th></tr>
            </thead>
            <tbody>
                @foreach (var a in _result.AssetTransactions)
                {
                    <tr>
                        <td><MudText Typo="Typo.body2" Class="mud-primary-text">@a.Symbol</MudText></td>
                        <td>@a.Transaction.Description</td>
                        <td>@a.Transaction.Money.Amount.ToString("N2")</td>
                        <td>@a.Transaction.Money.Currency</td>
                        <td>@a.Quantity</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }

    @if (_result.Errors.Count > 0)
    {
        <MudText Typo="Typo.subtitle1" GutterBottom="true">Errors</MudText>
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @foreach (var error in _result.Errors)
            {
                <MudText Typo="Typo.body2">@error</MudText>
            }
        </MudAlert>
    }

    @if (_result.ValidationErrors.Count > 0)
    {
        <MudText Typo="Typo.subtitle1" GutterBottom="true">Validation Errors</MudText>
        <MudSimpleTable Class="mb-4" Outlined="true">
            <thead>
                <tr><th>Field</th><th>Message</th></tr>
            </thead>
            <tbody>
                @foreach (var ve in _result.ValidationErrors)
                {
                    <tr><td>@ve.Field</td><td>@ve.Message</td></tr>
                }
            </tbody>
        </MudSimpleTable>
    }

    @if (_result.ValidationWarnings.Count > 0)
    {
        <MudText Typo="Typo.subtitle1" GutterBottom="true">Validation Warnings</MudText>
        <MudSimpleTable Outlined="true">
            <thead>
                <tr><th>Field</th><th>Message</th></tr>
            </thead>
            <tbody>
                @foreach (var ve in _result.ValidationWarnings)
                {
                    <tr><td>@ve.Field</td><td>@ve.Message</td></tr>
                }
            </tbody>
        </MudSimpleTable>
    }
}

@code {
    private ImportResultDto? _result;
    private bool _loading;
    private bool _showAssetTable;
    private IBrowserFile? _selectedFile;
    private IBrowserFile? _rawFile;
    private IBrowserFile? _degiroFile;

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        _result = null;
    }

    private void OnRawFileSelected(InputFileChangeEventArgs args)
    {
        _rawFile = args.File;
        _result = null;
    }

    private void OnDegiroFileSelected(InputFileChangeEventArgs args)
    {
        _degiroFile = args.File;
        _result = null;
    }

    private async Task UploadAndImportAsync()
    {
        if (_selectedFile is null) return;

        _loading = true;
        _result = null;
        _showAssetTable = false;
        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", _selectedFile.Name);

            var response = await Http.PostAsync("/api/import/upload", content);
            _result = await response.Content.ReadFromJsonAsync<ImportResultDto>();
            Snackbar.Add("Upload import completed.", Severity.Success);
            _selectedFile = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UploadDegiroAsync()
    {
        if (_degiroFile is null) return;

        _loading = true;
        _result = null;
        _showAssetTable = false;
        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = _degiroFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", _degiroFile.Name);

            var response = await Http.PostAsync("/api/import/upload", content);
            _result = await response.Content.ReadFromJsonAsync<ImportResultDto>();
            _showAssetTable = true;
            Snackbar.Add("DeGiro import completed.", Severity.Success);
            _degiroFile = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"DeGiro import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UploadRawCsvAsync()
    {
        if (_rawFile is null) return;

        _loading = true;
        _result = null;
        _showAssetTable = false;
        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = _rawFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", _rawFile.Name);

            var response = await Http.PostAsync("/api/import/raw-csv", content);
            var raw = await response.Content.ReadFromJsonAsync<RawCsvResultDto>();
            if (raw is not null)
            {
                Snackbar.Add($"Raw CSV import: {raw.Imported} imported, {raw.Skipped} skipped.", Severity.Success);
                if (raw.Errors?.Count > 0)
                {
                    foreach (var e in raw.Errors)
                    {
                        Snackbar.Add(e, Severity.Warning);
                    }
                }
            }
            _rawFile = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Raw CSV import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

}
