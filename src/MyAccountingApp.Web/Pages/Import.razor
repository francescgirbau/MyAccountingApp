@page "/import"
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Import</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Import Data</MudText>

<ImportSourceCard Title="Upload a CSV file"
                  Description="Select a CSV file from your computer to import. Supported formats are detected automatically."
                  ButtonColor="Color.Secondary" ButtonLabel="Upload &amp; Import"
                  FileName="@(_selectedFile?.Name)" Disabled="@(_selectedFile is null || _loading)"
                  OnFileSelected="@OnFileSelected" OnUpload="@UploadAndImportAsync" />

<ImportSourceCard Title="Import Interactive Brokers (Flex Query Report)"
                  Description="Upload a Flex Query report from Interactive Brokers. Trades, dividends, deposits, corporate actions, fees and interest are detected automatically."
                  ButtonColor="Color.Info" ButtonLabel="Import IBKR"
                  FileName="@(_ibkrFile?.Name)" Disabled="@(_ibkrFile is null || _loading)"
                  OnFileSelected="@OnIbkrFileSelected" OnUpload="@UploadIbkrAsync">
    <AlertContent>
        <strong>Format detected by filename.</strong> Files starting with <strong>U8997440_</strong> are routed to the IBKR Flex Query parser.<br />
        <strong>Trades</strong> become portfolio/option entries. <strong>Dividends</strong>, <strong>Fees</strong>, <strong>Deposits</strong>, <strong>Interest</strong> and <strong>Withholding Tax</strong> become cash transactions.
    </AlertContent>
</ImportSourceCard>

<ImportSourceCard Title="Import DeGiro / Flatex CSV"
                  Description="Upload a CSV exported from DeGiro or Flatex (Spanish format). Asset transactions, dividends, and fees are detected automatically."
                  ButtonColor="Color.Success" ButtonLabel="Import DeGiro"
                  FileName="@(_degiroFile?.Name)" Disabled="@(_degiroFile is null || _loading)"
                  OnFileSelected="@OnDegiroFileSelected" OnUpload="@UploadDegiroAsync">
    <AlertContent>
        <strong>Format detected automatically.</strong> Expected columns: Fecha, Hora, Fecha valor, Producto, ISIN, Descripción, Tipo, Variación, (amount), Saldo, (balance), ID Orden.<br />
        <strong>Compra</strong> / <strong>Venta</strong> rows become portfolio entries. <strong>Dividendo</strong>, <strong>Retención</strong> and <strong>Costes</strong> become cash transactions. Internal transfers are skipped.
    </AlertContent>
</ImportSourceCard>

<ImportSourceCard Title="Import Revolut CSV"
                  Description="Upload a CSV exported from Revolut. Deposits, card payments, ATM withdrawals, and transfers are detected automatically."
                  ButtonColor="Color.Tertiary" ButtonLabel="Import Revolut"
                  FileName="@(_revolutFile?.Name)" Disabled="@(_revolutFile is null || _loading)"
                  OnFileSelected="@OnRevolutFileSelected" OnUpload="@UploadRevolutAsync">
    <AlertContent>
        <strong>Format detected automatically.</strong> Expected columns: Type, Product, Started Date, Completed Date, Description, Amount, Fee, Currency, State, Balance.<br />
        <strong>Deposits</strong> and <strong>transfers</strong> become cash entries. Fees are handled as separate expense transactions.
    </AlertContent>
</ImportSourceCard>

<ImportSourceCard Title="Import ABN AMRO CSV"
                  Description="Upload a CSV exported from ABN AMRO. Card payments, transfers, direct debits, and salary are detected automatically."
                  ButtonColor="Color.Tertiary" ButtonLabel="Import ABN AMRO"
                  FileName="@(_abnAmroFile?.Name)" Disabled="@(_abnAmroFile is null || _loading)"
                  OnFileSelected="@OnAbnAmroFileSelected" OnUpload="@UploadAbnAmroAsync">
    <AlertContent>
        <strong>Format detected automatically.</strong> Expected columns: accountNumber, mutationcode, transactiondate, valuedate, startsaldo, endsaldo, amount, description.<br />
        <strong>Betaalpas</strong> and <strong>iDEAL</strong> become expenses. <strong>Overboeking</strong> to brokers become transfers. Salary from <strong>Spectral/Tesla</strong> becomes income.
    </AlertContent>
</ImportSourceCard>

<ImportSourceCard Title="Import Cobas (Investment Funds)"
                  Description="Upload a CSV exported from Cobas. Fund subscriptions and transfers are detected automatically and become portfolio entries."
                  ButtonColor="Color.Warning" ButtonLabel="Import Cobas"
                  FileName="@(_cobasFile?.Name)" Disabled="@(_cobasFile is null || _loading)"
                  OnFileSelected="@OnCobasFileSelected" OnUpload="@UploadCobasAsync">
    <AlertContent>
        <strong>Format detected automatically.</strong> Expected columns: Operacion, Producto, Fecha, Tipo, Estado, Importe, Valor liquidativo, Participaciones.<br />
        <strong>Suscripción</strong> / <strong>Traspaso de entrada</strong> become portfolio entries. <strong>Reembolso</strong> / <strong>Traspaso de salida</strong> become sells. Cancelled (<strong>Anulada</strong>) rows are skipped. Quantity is the fractional <strong>Participaciones</strong> value.
    </AlertContent>
</ImportSourceCard>

<ImportSourceCard Title="Import MyInvestor (Account &amp; Funds)"
                  Description="Upload a CSV exported from MyInvestor. Account statements and fund orders are detected automatically."
                  ButtonColor="Color.Tertiary" ButtonLabel="Import MyInvestor"
                  FileName="@(_myInvestorFile?.Name)" Disabled="@(_myInvestorFile is null || _loading)"
                  OnFileSelected="@OnMyInvestorFileSelected" OnUpload="@UploadMyInvestorAsync">
    <AlertContent>
        <strong>Format detected automatically.</strong> Account file columns: Fecha de operación; Fecha de valor; Concepto; Importe; Divisa. Fund orders file columns: Fecha de la orden; ISIN; Importe estimado; Nº de participaciones; Estado.<br />
        <strong>Account rows</strong> become cash entries (expenses, income and transfers). <strong>Fund orders</strong> become portfolio entries with the ISIN as symbol and fractional participations as quantity.
    </AlertContent>
</ImportSourceCard>

<ImportSourceCard Title="Import SelfBank (Account &amp; Funds)"
                  Description="Upload a CSV exported from SelfBank. Account statements and fund movements are detected automatically by filename."
                  ButtonColor="Color.Default" ButtonLabel="Import SelfBank"
                  FileName="@(_selfBankFile?.Name)" Disabled="@(_selfBankFile is null || _loading)"
                  OnFileSelected="@OnSelfBankFileSelected" OnUpload="@UploadSelfBankAsync">
    <AlertContent>
        <strong>Format detected by filename.</strong> Files starting with <strong>selfbank_found</strong> are routed to the fund movements parser; other <strong>selfbank</strong> files to the account parser.<br />
        <strong>Account rows</strong> become cash entries (expenses, income and transfers). <strong>Fund movements</strong> (Suscripción / Suscripción traspaso) become portfolio entries with the fund name as symbol; Reembolso rows become sells; cash-only movements are skipped.
    </AlertContent>
</ImportSourceCard>

<ImportSourceCard Title="Import Coinbase CSV"
                  Description="Upload a CSV exported from Coinbase (Transaction History). Crypto buys/sells, deposits and withdrawals are detected automatically."
                  ButtonColor="Color.Tertiary" ButtonLabel="Import Coinbase"
                  FileName="@(_coinbaseFile?.Name)" Disabled="@(_coinbaseFile is null || _loading)"
                  OnFileSelected="@OnCoinbaseFileSelected" OnUpload="@UploadCoinbaseAsync">
    <AlertContent>
        <strong>Format detected automatically.</strong> Expected columns: User, ID, Timestamp, Transaction Type, Asset, Quantity Transacted, Price Currency, Price at Transaction, Subtotal, Total (inclusive of fees and/or spread), Fees and/or Spread, Notes, Sender Address, Recipient Address.<br />
        <strong>Buy</strong> / <strong>Sell</strong> rows become portfolio entries with the asset symbol. <strong>Deposit</strong> rows become cash deposits. <strong>Withdrawal</strong> rows become transfers. Convert, Receive, Send and other rows are skipped.
    </AlertContent>
</ImportSourceCard>

<ImportSourceCard Title="Import Raw CSV"
                  Description="Upload a CSV with your own format. No transformations applied."
                  ButtonColor="Color.Primary" ButtonLabel="Import Raw CSV"
                  FileName="@(_rawFile?.Name)" Disabled="@(_rawFile is null || _loading)"
                  OnFileSelected="@OnRawFileSelected" OnUpload="@UploadRawCsvAsync">
    <AlertContent>
        <strong>Format:</strong> Date,Description,Amount,Type,Currency (Type: Income, Expense, Transfer, Deposit; Currency optional, defaults to EUR)
    </AlertContent>
</ImportSourceCard>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
}

<ImportResultReport Result="@_result"
                    EditableSymbols="@_editableSymbols"
                    SymbolResults="@_symbolResults"
                    SymbolSearching="@_symbolSearching"
                    SavingSymbols="@_savingSymbols"
                    OnSearchSymbol="@(r => SearchSymbolAsync(r.AssetId, r.Description))"
                    OnSelectSymbolResult="@(s => SelectSymbolResult(s.AssetId, s.Symbol))"
                    OnSave="@SaveSymbolCorrectionsAsync" />

@code {
    private ImportResultDto? _result;
    private bool _loading;
    private bool _savingSymbols;
    private Dictionary<Guid, string> _editableSymbols = new();
    private Dictionary<Guid, List<SymbolLookupResult>> _symbolResults = new();
    private HashSet<Guid> _symbolSearching = new();
    private IBrowserFile? _selectedFile;
    private IBrowserFile? _rawFile;
    private IBrowserFile? _degiroFile;
    private IBrowserFile? _ibkrFile;
    private IBrowserFile? _revolutFile;
    private IBrowserFile? _abnAmroFile;
    private IBrowserFile? _cobasFile;
    private IBrowserFile? _myInvestorFile;
    private IBrowserFile? _selfBankFile;
    private IBrowserFile? _coinbaseFile;

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        _result = null;
    }

    private void OnRawFileSelected(InputFileChangeEventArgs args)
    {
        _rawFile = args.File;
        _result = null;
    }

    private void OnDegiroFileSelected(InputFileChangeEventArgs args)
    {
        _degiroFile = args.File;
        _result = null;
    }

    private void OnRevolutFileSelected(InputFileChangeEventArgs args)
    {
        _revolutFile = args.File;
        _result = null;
    }

    private void OnAbnAmroFileSelected(InputFileChangeEventArgs args)
    {
        _abnAmroFile = args.File;
        _result = null;
    }

    private void OnCobasFileSelected(InputFileChangeEventArgs args)
    {
        _cobasFile = args.File;
        _result = null;
    }

    private void OnMyInvestorFileSelected(InputFileChangeEventArgs args)
    {
        _myInvestorFile = args.File;
        _result = null;
    }

    private void OnSelfBankFileSelected(InputFileChangeEventArgs args)
    {
        _selfBankFile = args.File;
        _result = null;
    }

    private void OnCoinbaseFileSelected(InputFileChangeEventArgs args)
    {
        _coinbaseFile = args.File;
        _result = null;
    }

    private void OnIbkrFileSelected(InputFileChangeEventArgs args)
    {
        _ibkrFile = args.File;
        _result = null;
    }

    private async Task UploadFileAsync(IBrowserFile? file, Action resetFile, string successMessage, string failMessage)
    {
        if (file is null) return;

        _loading = true;
        _result = null;
        _editableSymbols = new();
        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", file.Name);

            var response = await Http.PostAsync("/api/import/upload", content);
            _result = await response.Content.ReadFromJsonAsync<ImportResultDto>();
            InitEditableSymbols();
            Snackbar.Add(successMessage, Severity.Success);
            resetFile();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{failMessage}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UploadAndImportAsync() =>
        await UploadFileAsync(_selectedFile, () => _selectedFile = null, "Upload import completed.", "Upload failed");

    private async Task UploadIbkrAsync() =>
        await UploadFileAsync(_ibkrFile, () => _ibkrFile = null, "IBKR import completed.", "IBKR import failed");

    private async Task UploadDegiroAsync() =>
        await UploadFileAsync(_degiroFile, () => _degiroFile = null, "DeGiro import completed.", "DeGiro import failed");

    private async Task UploadRevolutAsync() =>
        await UploadFileAsync(_revolutFile, () => _revolutFile = null, "Revolut import completed.", "Revolut import failed");

    private async Task UploadAbnAmroAsync() =>
        await UploadFileAsync(_abnAmroFile, () => _abnAmroFile = null, "ABN AMRO import completed.", "ABN AMRO import failed");

    private async Task UploadCobasAsync() =>
        await UploadFileAsync(_cobasFile, () => _cobasFile = null, "Cobas import completed.", "Cobas import failed");

    private async Task UploadMyInvestorAsync() =>
        await UploadFileAsync(_myInvestorFile, () => _myInvestorFile = null, "MyInvestor import completed.", "MyInvestor import failed");

    private async Task UploadSelfBankAsync() =>
        await UploadFileAsync(_selfBankFile, () => _selfBankFile = null, "SelfBank import completed.", "SelfBank import failed");

    private async Task UploadCoinbaseAsync() =>
        await UploadFileAsync(_coinbaseFile, () => _coinbaseFile = null, "Coinbase import completed.", "Coinbase import failed");

    private async Task UploadRawCsvAsync()
    {
        if (_rawFile is null) return;

        _loading = true;
        _result = null;
        _editableSymbols = new();
        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = _rawFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            content.Add(new StreamContent(stream), "file", _rawFile.Name);

            var response = await Http.PostAsync("/api/import/raw-csv", content);
            var raw = await response.Content.ReadFromJsonAsync<RawCsvResultDto>();
            if (raw is not null)
            {
                Snackbar.Add($"Raw CSV import: {raw.Imported} imported, {raw.Skipped} skipped.", Severity.Success);
                if (raw.Errors?.Count > 0)
                {
                    foreach (var e in raw.Errors)
                    {
                        Snackbar.Add(e, Severity.Warning);
                    }
                }
            }
            _rawFile = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Raw CSV import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void InitEditableSymbols()
    {
        if (_result is null) return;
        _editableSymbols = new();
        foreach (var a in _result.AssetTransactions)
        {
            _editableSymbols[a.Transaction.Id] = a.Symbol;
        }
    }

    private async Task SaveSymbolCorrectionsAsync()
    {
        if (_result is null || _editableSymbols.Count == 0) return;

        _savingSymbols = true;
        int saved = 0;
        int errors = 0;

        foreach (var kv in _editableSymbols)
        {
            int originalIndex = _result.AssetTransactions.FindIndex(a => a.Transaction.Id == kv.Key);
            AssetTransactionDto? original = originalIndex >= 0 ? _result.AssetTransactions[originalIndex] : null;
            if (original is null) continue;
            if (original.Symbol == kv.Value) continue;

            try
            {
                var request = new
                {
                    date = original.Transaction.Date,
                    description = original.Transaction.Description,
                    amount = original.Transaction.Money.Amount,
                    currency = original.Transaction.Money.Currency,
                    category = original.Transaction.Category,
                    symbol = kv.Value,
                    quantity = original.Quantity,
                    type = original.Type,
                };

                var response = await Http.PutAsJsonAsync($"/api/asset-transactions/{kv.Key}", request);
                if (response.IsSuccessStatusCode)
                {
                    original = original with { Symbol = kv.Value };
                    _result.AssetTransactions[originalIndex] = original;
                    saved++;
                }
                else
                {
                    errors++;
                }
            }
            catch
            {
                errors++;
            }
        }

        _savingSymbols = false;

        if (errors == 0)
        {
            Snackbar.Add($"Symbols corrected: {saved} updated.", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Symbols corrected: {saved} updated, {errors} failed.", Severity.Warning);
        }
    }

    private async Task SearchSymbolAsync(Guid assetId, string description)
    {
        if (_symbolSearching.Contains(assetId)) return;

        _symbolSearching.Add(assetId);
        _symbolResults.Remove(assetId);

        string name = description;
        int atIdx = description.IndexOf('@');
        if (atIdx > 0)
        {
            string beforeAt = description[..atIdx].Trim();
            string stripped = beforeAt.Replace("Compra ", string.Empty).Replace("Venta ", string.Empty).Trim();
            int firstSpace = stripped.IndexOf(' ');
            if (firstSpace > 0 && int.TryParse(stripped[..firstSpace], out int _))
            {
                stripped = stripped[(firstSpace + 1)..].Trim();
            }
            name = stripped;
        }

        try
        {
            var results = await Http.GetFromJsonAsync<List<SymbolLookupResult>>($"/api/symbol-lookup?name={Uri.EscapeDataString(name)}");
            _symbolResults[assetId] = results ?? new();
        }
        catch
        {
            _symbolResults[assetId] = new();
        }
        finally
        {
            _symbolSearching.Remove(assetId);
        }
    }

    private void SelectSymbolResult(Guid assetId, string symbol)
    {
        _editableSymbols[assetId] = symbol;
        _symbolResults.Remove(assetId);
    }
}