@page "/options"
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Options</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Options</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_allTransactions.Count == 0)
{
    <MudPaper Class="pa-8 text-center" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Large" Class="mud-text-secondary" />
        <MudText Typo="Typo.h5" Class="mt-4">No option transactions yet</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">Import your first CSV to get started.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload"
                   OnClick="@(() => Navigation.NavigateTo("import"))">
            Go to Import
        </MudButton>
    </MudPaper>
}
else
{
    <MudTabs Class="mt-0">
        <MudTabPanel Text="Positions">
            <OptionPositionTable Positions="@_positions" OnRefresh="@LoadDataAsync" />
        </MudTabPanel>
        <MudTabPanel Text="Transactions">
            <OptionTransactionFilters
                AvailableYears="@_availableYears"
                SelectedYear="@_selectedYear"
                SelectedYearChanged="@OnYearChanged"
                AvailableSymbols="@_availableSymbols"
                SelectedSymbol="@_selectedSymbol"
                SelectedSymbolChanged="@OnSymbolChanged"
                OnDeleteYear="@OpenDeleteYearDialog" />

            @if (_selected.Count > 0)
            {
                <MudPaper Class="pa-2 mb-2 d-flex align-center" Outlined="true">
                    <MudChip T="int" Color="Color.Primary" Size="Size.Small">@_selected.Count selected</MudChip>
                    <MudText Typo="Typo.body2" Class="ml-2 mud-text-secondary">visible rows selected — bulk actions apply only to these</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="@OpenBulkSymbolDialog" StartIcon="@Icons.Material.Filled.Edit">
                        Change symbol
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@ClearSelection" Size="Size.Small" />
                </MudPaper>
            }

            <OptionTransactionList Transactions="@_filteredTransactions"
                                    Selected="@_selected"
                                    SelectedChanged="@OnSelectedChanged"
                                    OnRefresh="@LoadDataAsync"
                                    OnEdit="@OpenEditDialog"
                                    OnDelete="@OpenDeleteDialog" />
        </MudTabPanel>
    </MudTabs>
}

<OptionTransactionFormDialog @bind-Visible="_showFormDialog"
                             Transaction="@_editingTx"
                             SaveRequested="@SaveAsync" />

<DeleteOptionTransactionDialog Visible="@_showDeleteDialog"
                              VisibleChanged="@OnDeleteDialogVisibleChanged"
                              Transaction="@_deletingTx"
                              ConfirmRequested="@ConfirmDeleteAsync" />

<BulkOptionSymbolDialog @bind-Visible="_showBulkSymbolDialog"
                        SelectedCount="@_selected.Count"
                        ConfirmRequested="@ConfirmBulkSymbolAsync" />

<DeleteOptionYearDialog Visible="@_showDeleteYearDialog"
                        VisibleChanged="@OnDeleteYearDialogVisibleChanged"
                        Year="@_selectedYear"
                        Count="@_deleteYearCount"
                        ConfirmRequested="@ConfirmDeleteYearAsync" />

@code {
    private List<OptionTransactionDto> _allTransactions = new();
    private List<OptionTransactionDto> _filteredTransactions = new();
    private List<OptionPositionDto> _positions = new();
    private List<int> _availableYears = new();
    private List<string> _availableSymbols = new();
    private bool _loading = true;

    private int? _selectedYear { get; set; }
    private string? _selectedSymbol { get; set; }

    private bool _showFormDialog;
    private Guid? _editingId;
    private OptionTransactionDto? _editingTx;

    private bool _showDeleteDialog;
    private OptionTransactionDto? _deletingTx;

    private bool _showBulkSymbolDialog;
    private HashSet<OptionTransactionDto> _selected = new();

    private bool _showDeleteYearDialog;
    private int? _deleteYearCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _allTransactions = await Http.GetFromJsonAsync<List<OptionTransactionDto>>("/api/option-transactions") ?? new();
            _positions = await Http.GetFromJsonAsync<List<OptionPositionDto>>("/api/option-positions") ?? new();
            _availableYears = _allTransactions
                .Select(t => t.Transaction.Date.Year)
                .Distinct()
                .OrderByDescending(y => y)
                .ToList();
            _availableSymbols = _allTransactions
                .Select(t => t.Symbol)
                .Distinct()
                .OrderBy(s => s)
                .ToList();
            ApplyFilters();
            _selected.Clear();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnYearChanged(int? year)
    {
        _selectedYear = year;
        ApplyFilters();
    }

    private void OnSymbolChanged(string? symbol)
    {
        _selectedSymbol = symbol;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = _allTransactions.AsEnumerable();

        if (_selectedYear.HasValue)
            query = query.Where(t => t.Transaction.Date.Year == _selectedYear.Value);

        if (!string.IsNullOrWhiteSpace(_selectedSymbol))
            query = query.Where(t => t.Symbol == _selectedSymbol);

        _filteredTransactions = query.OrderByDescending(t => t.Transaction.Date).ToList();
        HashSet<Guid> filteredIds = _filteredTransactions.Select(t => t.Transaction.Id).ToHashSet();
        _selected.RemoveWhere(item => !filteredIds.Contains(item.Transaction.Id));
    }

    private void OpenEditDialog(OptionTransactionDto tx)
    {
        _editingId = tx.Transaction.Id;
        _editingTx = tx;
        _showFormDialog = true;
    }

    private async Task SaveAsync(OptionTransactionFormValue value)
    {
        try
        {
            var payload = new
            {
                Date = value.Date,
                Description = value.Description,
                Amount = value.Amount,
                Currency = value.Currency,
                Category = "EXPENSE",
                Symbol = value.Symbol,
                Isin = value.Isin,
                Quantity = value.Quantity,
                Type = value.Type,
            };

            HttpResponseMessage response = await Http.PutAsJsonAsync($"/api/option-transactions/{_editingId}", payload);
            if (response.IsSuccessStatusCode)
            {
                _showFormDialog = false;
                Snackbar.Add("Option transaction updated", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to save: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void ClearSelection()
    {
        _selected.Clear();
    }

    private static string Trim(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "no details";
        }

        return value.Length <= 200 ? value : value[..200] + "...";
    }

    private void OpenBulkSymbolDialog()
    {
        _showBulkSymbolDialog = true;
    }

    private async Task ConfirmBulkSymbolAsync(string symbol)
    {
        if (_selected.Count == 0 || string.IsNullOrWhiteSpace(symbol))
        {
            return;
        }

        List<OptionTransactionDto> targets = _selected.Where(s => _filteredTransactions.Any(f => f.Transaction.Id == s.Transaction.Id)).ToList();
        if (targets.Count == 0)
        {
            Snackbar.Add("No visible rows selected", Severity.Warning);
            return;
        }

        var payload = new
        {
            ids = targets.Select(t => t.Transaction.Id).ToList(),
            patch = new { symbol = symbol.Trim() },
        };

        try
        {
            HttpResponseMessage response = await Http.PatchAsJsonAsync("/api/option-transactions/batch", payload);
            if (!response.IsSuccessStatusCode)
            {
                string body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Bulk update failed ({(int)response.StatusCode}): {Trim(body)}", Severity.Error);
                return;
            }

            BatchPatchResult? result = await response.Content.ReadFromJsonAsync<BatchPatchResult>();
            _showBulkSymbolDialog = false;
            _selected.Clear();

            if (result is null)
            {
                Snackbar.Add("Bulk update failed", Severity.Error);
            }
            else if (result.Failures.Count == 0)
            {
                Snackbar.Add($"{result.Updated} option transaction(s) updated", Severity.Success);
            }
            else
            {
                string details = string.Join("; ", result.Failures.Select(f => f.Error));
                Snackbar.Add($"{result.Updated} updated, {result.Failures.Count} failed: {details}", Severity.Warning);
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenDeleteDialog(OptionTransactionDto tx)
    {
        _deletingTx = tx;
        _showDeleteDialog = true;
    }

    private void OnDeleteDialogVisibleChanged(bool value)
    {
        _showDeleteDialog = value;
        if (!value)
        {
            _deletingTx = null;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deletingTx is null) return;

        try
        {
            HttpResponseMessage response = await Http.DeleteAsync($"/api/option-transactions/{_deletingTx.Transaction.Id}");
            _showDeleteDialog = false;
            _deletingTx = null;

            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                Snackbar.Add("Option transaction deleted", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to delete: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenDeleteYearDialog()
    {
        if (!_selectedYear.HasValue) return;

        _deleteYearCount = null;
        _showDeleteYearDialog = true;

        try
        {
            var countResult = await Http.GetFromJsonAsync<Dictionary<string, object>>($"/api/option-transactions/year/{_selectedYear}/count");
            _deleteYearCount = countResult?.GetValueOrDefault("options") is JsonElement je ? je.GetInt32() : 0;
        }
        catch
        {
            _deleteYearCount = 0;
        }
    }

    private void OnDeleteYearDialogVisibleChanged(bool value)
    {
        _showDeleteYearDialog = value;
        if (!value)
        {
            _deleteYearCount = null;
        }
    }

    private async Task ConfirmDeleteYearAsync()
    {
        if (!_selectedYear.HasValue) return;

        try
        {
            HttpResponseMessage response = await Http.DeleteAsync($"/api/option-transactions/year/{_selectedYear}");
            _showDeleteYearDialog = false;
            _deleteYearCount = null;

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Deleted option transactions for {_selectedYear}", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to delete: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OnSelectedChanged(HashSet<OptionTransactionDto> value)
    {
        _selected = value;
    }
}
