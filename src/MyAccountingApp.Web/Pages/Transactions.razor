    private DateTime GetDefaultFxDate()
    {
        // 1. Year + month from filter → 1st of that month
        if (_selectedYear.HasValue && _selectedMonth.HasValue)
        {
            return new DateTime(_selectedYear.Value, _selectedMonth.Value, 1);
        }
        
        // 2. Year only, current year → today; otherwise Jan 1 of that year
        if (_selectedYear.HasValue)
        {
            int year = _selectedYear.Value;
            if (year == DateTime.Today.Year)
            {
                return DateTime.Today;
            }
            return new DateTime(year, 1, 1);
        }
        
        // 3. Fallback: today
        return DateTime.Today;
    }

