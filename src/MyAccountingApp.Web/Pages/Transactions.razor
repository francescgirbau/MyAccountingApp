    private string? GetCounterText(TransactionDto tx)
    {
        if (tx.FxPairId is null)
        {
            return null;
        }

        TransactionDto? sibling = _allTransactions.FirstOrDefault(t => t.FxPairId == tx.FxPairId && t.Id != tx.Id);
        string arrow = tx.FxLeg == "Out" ? "->" : "<-";
        string amount = sibling is null
            ? "no counterpart"
            : $"{arrow} {sibling.Money.Amount.ToString("N2")} {sibling.Money.Currency}";
        string rate = tx.FxBrokerRate is not null ? $" @ {tx.FxBrokerRate:G}" : string.Empty;
        return $"{amount}{rate}";
    }

