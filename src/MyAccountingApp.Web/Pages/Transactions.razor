    private static readonly string[] OperatingBucket = { "INCOME", "EXPENSE", "DIVIDEND", "INTEREST", "FEE", "WITHHOLDING_TAX" };
    private static readonly string[] InternalBucket = { "TRANSFER", "DEPOSIT" };
    private static readonly string[] FxBucket = { "FX_CONVERSION" };

    private static bool IsBucketActive(IEnumerable<string> bucket, IReadOnlySet<string> selected) => bucket.All(selected.Contains);

    private void ToggleBucket(IEnumerable<string> bucket)
    {
        if (IsBucketActive(bucket, _selectedCategories))
        {
            foreach (string cat in bucket)
            {
                _selectedCategories.Remove(cat);
            }
        }
        else
        {
            foreach (string cat in bucket)
            {
                _selectedCategories.Add(cat);
            }
        }

        ApplyFilters();
    }

