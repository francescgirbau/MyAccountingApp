@page "/transactions"
@using MyAccountingApp.Application.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Transactions</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Transactions</MudText>

@if (_issueContext is not null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        <MudText Typo="Typo.body2" Class="d-inline">
            Showing <strong>@_filteredTransactions.Count</strong> impacted transaction(s) from Data Quality
            @if (!string.IsNullOrEmpty(IssueFromQuery))
            {
                <text>· @IssueFromQuery</text>
            }
        </MudText>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@ClearIssueFilter">Clear filter</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo("/data-quality"))">Back to Data Quality</MudButton>
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_selectedYear" @bind-Value:after="OnYearChanged" Label="Year" Variant="Variant.Outlined" FullWidth="true" Clearable="true">
                @foreach (var year in _availableYears)
                {
                    <MudSelectItem T="int?" Value="@((int?)year)">@year</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_selectedMonth" @bind-Value:after="ApplyFilters" Label="Month" Variant="Variant.Outlined" FullWidth="true" Clearable="true"
                       Disabled="@(!_selectedYear.HasValue)">
                @for (int m = 1; m <= 12; m++)
                {
                    var month = m;
                    <MudSelectItem T="int?" Value="@((int?)month)">@_monthNames[month - 1]</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" Label="Categories" Variant="Variant.Outlined" FullWidth="true"
                       MultiSelection="true"
                       SelectedValues="@_selectedCategories"
                       SelectedValuesChanged="@OnCategoriesChanged"
                       ToStringFunc="@(value => value ?? string.Empty)"
                       MultiSelectionTextFunc="@CategoriesSelectionText">
                @foreach (var cat in _categories)
                {
                    <MudSelectItem T="string" Value="@cat">@cat</MudSelectItem>
                }
            </MudSelect>
            @if (_selectedCategories.Count > 0)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="@ClearCategories" Class="mt-1">
                    Clear categories
                </MudButton>
            }
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="_searchText" @bind-Value:after="ApplyFilters" Label="Search description" Variant="Variant.Outlined" FullWidth="true" Immediate="true" Placeholder="Type to search..." />
        </MudItem>
    </MudGrid>
    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Quick filters</MudText>
    <div class="d-flex flex-wrap gap-2">
        <MudChip T="string" Color="@(IsBucketActive(OperatingBucket, _selectedCategories) ? Color.Primary : Color.Default)"
                 Variant="@(IsBucketActive(OperatingBucket, _selectedCategories) ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => ToggleBucket(OperatingBucket))">Operating</MudChip>
        <MudChip T="string" Color="@(IsBucketActive(InternalBucket, _selectedCategories) ? Color.Primary : Color.Default)"
                 Variant="@(IsBucketActive(InternalBucket, _selectedCategories) ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => ToggleBucket(InternalBucket))">Internal moves</MudChip>
        <MudChip T="string" Color="@(IsBucketActive(FxBucket, _selectedCategories) ? Color.Primary : Color.Default)"
                 Variant="@(IsBucketActive(FxBucket, _selectedCategories) ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => ToggleBucket(FxBucket))">FX</MudChip>
        <MudTooltip Placement="Placement.Top">
            <ChildContent>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.TrendingUp"
                           OnClick="@NavigateToInvestments">View investments</MudButton>
            </ChildContent>
            <TooltipContent><span>View asset purchases and sales, quantities and prices.</span></TooltipContent>
        </MudTooltip>
    </div>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
        Quick filters select whole cash-flow buckets. Use the Categories dropdown for finer control.
    </MudText>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_allTransactions.Count == 0)
{
    <MudPaper Class="pa-8 text-center" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Class="mud-text-secondary" />
        <MudText Typo="Typo.h5" Class="mt-4">No transactions yet</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">Import your first CSV or create a transaction manually.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload"
                   OnClick="@(() => Navigation.NavigateTo("import"))">
            Go to Import
        </MudButton>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">
            Filtered totals — @_filteredTransactions.Count transactions
        </MudText>
        @if (_filterSummaries.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No transactions match the current filters.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="false" Bordered="false" Style="background: transparent;">
                <thead>
                    <tr>
                        <th rowspan="2">Currency</th>
                        <th style="text-align:center" colspan="3">Operating</th>
                        <th style="text-align:center" colspan="2">Investing</th>
                        <th style="text-align:center" colspan="2">Internal</th>
                        <th style="text-align:center" colspan="2" class="mud-text-secondary">FX</th>
                    </tr>
                    <tr>
                        <th style="text-align:right">Income</th>
                        <th style="text-align:right">Expense</th>
                        <th style="text-align:right">Net</th>
                        <th style="text-align:right">Purchases</th>
                        <th style="text-align:right">Sales</th>
                        <th style="text-align:right">Out</th>
                        <th style="text-align:right">In</th>
                        <th style="text-align:right" class="mud-text-secondary">Out</th>
                        <th style="text-align:right" class="mud-text-secondary">In</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _filterSummaries)
                    {
                        <tr>
                            <td><strong>@s.Currency</strong> <span class="mud-text-secondary">(@s.Count)</span></td>
                            <td style="text-align:right" class="green--text">@s.Income.ToString("N2")</td>
                            <td style="text-align:right" class="red--text">@s.Expense.ToString("N2")</td>
                            <td style="text-align:right">
                                <strong class="@(s.OperatingNet >= 0 ? "green--text" : "red--text")">@s.OperatingNet.ToString("N2")</strong>
                            </td>
                            <td style="text-align:right">@s.InvestingPurchase.ToString("N2")</td>
                            <td style="text-align:right">@s.InvestingSale.ToString("N2")</td>
                            <td style="text-align:right">@s.Transfer.ToString("N2")</td>
                            <td style="text-align:right">@s.Deposit.ToString("N2")</td>
                            <td style="text-align:right" class="mud-text-secondary">@s.FxOut.ToString("N2")</td>
                            <td style="text-align:right" class="mud-text-secondary">@s.FxIn.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                Operating net = Income − Expense. Investing (asset purchase/sale) and internal transfers/deposits are excluded from Operating net; FX legs sit in their own out / in columns (not in Operating net).
            </MudText>
        }
    </MudPaper>

    @if (_selected.Count > 0)
    {
        <MudPaper Class="pa-2 mb-2 d-flex align-center" Outlined="true">
            <MudChip T="int" Color="Color.Primary" Size="Size.Small">@_selected.Count selected</MudChip>
            <MudText Typo="Typo.body2" Class="ml-2 mud-text-secondary">visible rows selected — bulk actions apply only to these</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       OnClick="@OpenBulkCategoryDialog" StartIcon="@Icons.Material.Filled.Edit">
                Change category
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@ClearSelection" Size="Size.Small" />
        </MudPaper>
    }

    <MudTable Items="@_filteredTransactions" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Striped="true" SortLabel="Sort by"
              MultiSelection="true" @bind-SelectedItems="_selected">
        <ToolBarContent>
            <MudText Typo="Typo.subtitle1">@_filteredTransactions.Count transactions</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       OnClick="@OpenCreateDialog" StartIcon="@Icons.Material.Filled.Add">
                New
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Class="ml-2"
                       OnClick="@OpenFxDialog" StartIcon="@Icons.Material.Filled.SwapHoriz">
                New FX
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="@LoadDataAsync" Size="Size.Small" aria-label="Refresh" />
        </ToolBarContent>
        <ColGroup>
            <col style="width: 120px" />
            <col />
            <col style="width: 100px" />
            <col style="width: 80px" />
            <col style="width: 100px" />
            <col style="width: 140px" />
            <col style="width: 80px" />
        </ColGroup>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<TransactionDto, object>(t => t.Date)">Date</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TransactionDto, object>(t => t.Description)">Description</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TransactionDto, object>(t => t.Money.Amount)">Amount</MudTableSortLabel></MudTh>
            <MudTh>Curr.</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TransactionDto, object>(t => t.Category)">Category</MudTableSortLabel></MudTh>
            <MudTh>Source</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.Date.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Amount"><span class="@(context.Category == "EXPENSE" || context.Category == "FEE" || context.Category == "WITHHOLDING_TAX" || context.Category == "TRANSFER" ? "red--text" : "green--text")">@context.Money.Amount.ToString("N2")</span></MudTd>
            <MudTd DataLabel="Curr.">@context.Money.Currency</MudTd>
            <MudTd DataLabel="Category">
                @if (GetCategoryTooltip(context.Category) is string tip)
                {
                    <MudTooltip Placement="Placement.Top">
                        <ChildContent>
                            <MudChip T="string" Size="Size.Small" Color="@GetCategoryColor(context.Category)">@GetCategoryLabel(context.Category)</MudChip>
                        </ChildContent>
                        <TooltipContent><span>@tip</span></TooltipContent>
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="@GetCategoryColor(context.Category)">@GetCategoryLabel(context.Category)</MudChip>
                }
                @if (!string.IsNullOrEmpty(context.FxLeg))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="ml-1">FX @(context.FxLeg == "Out" ? "out" : "in")</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Source">
                @if (!string.IsNullOrEmpty(context.Source))
                {
                    <MudText Typo="Typo.caption" Class="text-medium-emphasis">@context.Source</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption">—</MudText>
                }
                @if (context.FxPairId is not null)
                {
                    <MudText Typo="Typo.caption" Class="text-medium-emphasis">@GetCounterText(context)</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => OpenDeleteDialog(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new int[]{25, 50, 100})" />
        </PagerContent>
    </MudTable>
}

<MudDialog @bind-Visible="_showFormDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingId is null ? "New Transaction" : "Edit Transaction")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudDatePicker @bind-Date="_formDate" Label="Date" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_formDescription" Label="Description" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_formAmount" Label="Amount" Variant="Variant.Outlined" Min="@(0.01m)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_formCurrency" Label="Currency" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("EUR")">EUR</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                    <MudSelectItem Value="@("GBP")">GBP</MudSelectItem>
                    <MudSelectItem Value="@("CHF")">CHF</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect @bind-Value="_formCategory" Label="Category" Variant="Variant.Outlined">
                    @foreach (var cat in _categories.Where(c => c != "FX_CONVERSION"))
                    {
                        <MudSelectItem Value="cat">@cat</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CloseFormDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveAsync" Disabled="@IsFormInvalid()">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showBulkCategoryDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Change category</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            The new category will be applied to <strong>@_selected.Count</strong> selected transaction(s).
        </MudText>
        <MudSelect @bind-Value="_bulkCategory" Label="New category" Variant="Variant.Outlined">
            @foreach (var cat in _categories)
            {
                <MudSelectItem Value="cat">@cat</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CloseBulkCategoryDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ConfirmBulkCategoryAsync"
                   Disabled="@(string.IsNullOrWhiteSpace(_bulkCategory))">
            Update @_selected.Count
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showFxDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">New FX Conversion</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudDatePicker @bind-Date="_fxDate" Label="Date" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_fxFromAmount" Label="From amount" Variant="Variant.Outlined" Min="@(0.01m)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_fxFromCurrency" Label="From currency" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("EUR")">EUR</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                    <MudSelectItem Value="@("GBP")">GBP</MudSelectItem>
                    <MudSelectItem Value="@("CHF")">CHF</MudSelectItem>
                    <MudSelectItem Value="@("CAD")">CAD</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_fxToAmount" Label="To amount" Variant="Variant.Outlined" Min="@(0.01m)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_fxToCurrency" Label="To currency" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("EUR")">EUR</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                    <MudSelectItem Value="@("GBP")">GBP</MudSelectItem>
                    <MudSelectItem Value="@("CHF")">CHF</MudSelectItem>
                    <MudSelectItem Value="@("CAD")">CAD</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudNumericField T="decimal?" @bind-Value="_fxRate" Label="Rate (quote per base, optional)" Variant="Variant.Outlined" Min="@(0.000001m)" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CloseFxDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveFxAsync" Disabled="@IsFxFormInvalid()">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showDeleteDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete Transaction</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete this transaction?</MudText>
        @if (_deletingTx is not null)
        {
            <MudText Typo="Typo.body2" Class="mt-2">@_deletingTx.Date.ToString("yyyy-MM-dd") — @_deletingTx.Description (@_deletingTx.Money.Amount.ToString("N2") @_deletingTx.Money.Currency)</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@CloseDeleteDialog">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@ConfirmDeleteAsync">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<TransactionDto> _allTransactions = new();
    private List<TransactionDto> _filteredTransactions = new();
    private List<FilterCurrencySummary> _filterSummaries = new();
    private List<int> _availableYears = new();
    private bool _loading = true;

    private int? _selectedYear { get; set; }
    private int? _selectedMonth { get; set; }
    private HashSet<string> _selectedCategories = new(StringComparer.OrdinalIgnoreCase);
    private string? _searchText { get; set; }

    private static readonly string[] _categories = { "INCOME", "EXPENSE", "TRANSFER", "DEPOSIT", "DIVIDEND", "FEE", "WITHHOLDING_TAX", "INTEREST", "FX_CONVERSION" };
    private static readonly string[] _monthNames =
    {
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December",
    };

    private bool _showFormDialog;
    private bool _showFxDialog;
    private bool _showDeleteDialog;
    private bool _showBulkCategoryDialog;
    private Guid? _editingId;
    private TransactionDto? _deletingTx;
    private HashSet<TransactionDto> _selected = new();
    private string _bulkCategory = "";

    private DateTime? _fxDate;
    private decimal _fxFromAmount;
    private string _fxFromCurrency = "EUR";
    private decimal _fxToAmount;
    private string _fxToCurrency = "USD";
    private decimal? _fxRate;

    [SupplyParameterFromQuery(Name = "ids")]
    public string? IdsFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "issue")]
    public string? IssueFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "categories")]
    public string? CategoriesFromQuery { get; set; }

    private List<Guid> _impactedIds = new();
    private string? _issueContext;

    private DateTime? _formDate;
    private string _formDescription = "";
    private decimal _formAmount;
    private string _formCurrency = "EUR";
    private string _formCategory = "EXPENSE";

    protected override async Task OnInitializedAsync()
    {
        this.ApplyIssueFilterFromQuery();
        this.ApplyCategoriesFromQuery();
        await this.LoadDataAsync();
    }

    private void ApplyCategoriesFromQuery()
    {
        if (string.IsNullOrWhiteSpace(this.CategoriesFromQuery))
        {
            return;
        }

        foreach (string raw in this.CategoriesFromQuery.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            string? category = _categories.FirstOrDefault(c => string.Equals(c, raw, StringComparison.OrdinalIgnoreCase));
            if (category is not null)
            {
                _selectedCategories.Add(category);
            }
        }
    }

    private void ApplyIssueFilterFromQuery()
    {
        this._impactedIds = new();
        this._issueContext = null;

        if (string.IsNullOrWhiteSpace(this.IdsFromQuery))
        {
            return;
        }

        List<Guid> ids = this.IdsFromQuery
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => Guid.TryParse(s, out Guid g) ? g : Guid.Empty)
            .Where(g => g != Guid.Empty)
            .ToList();

        if (ids.Count > 0)
        {
            this._impactedIds = ids;
            this._issueContext = string.IsNullOrWhiteSpace(this.IssueFromQuery) ? "impacted transactions" : this.IssueFromQuery;
        }
    }

    private void ClearIssueFilter()
    {
        this._impactedIds = new();
        this._issueContext = null;
        this._selected.Clear();
        this.ApplyFilters();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _allTransactions = await Http.GetFromJsonAsync<List<TransactionDto>>("/api/transactions") ?? new();
            _availableYears = _allTransactions
                .Select(t => t.Date.Year)
                .Distinct()
                .OrderByDescending(y => y)
                .ToList();
            _selected.Clear();
            ApplyFilters();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnYearChanged()
    {
        if (!_selectedYear.HasValue)
            _selectedMonth = null;

        ApplyFilters();
    }

    private void OnCategoriesChanged(IEnumerable<string> values)
    {
        _selectedCategories.Clear();
        foreach (string value in values)
        {
            _selectedCategories.Add(value);
        }

        ApplyFilters();
    }

    private void ClearCategories()
    {
        _selectedCategories.Clear();
        ApplyFilters();
    }

    private static string CategoriesSelectionText(IReadOnlyList<string> values) => values.Count switch
    {
        0 => "All categories",
        1 => "1 category",
        _ => $"{values.Count} categories",
    };

    private void ApplyFilters()
    {
        var query = _allTransactions.AsEnumerable();

        if (_selectedYear.HasValue)
            query = query.Where(t => t.Date.Year == _selectedYear.Value);

        // Month only applies together with a year (no "all years for this month").
        if (_selectedYear.HasValue && _selectedMonth.HasValue)
            query = query.Where(t => t.Date.Month == _selectedMonth.Value);

        if (_selectedCategories.Count > 0)
            query = TransactionCategoryFilter.FilterByCategories(query, _selectedCategories, t => t.Category);

        if (!string.IsNullOrWhiteSpace(_searchText))
            query = query.Where(t => t.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

        if (_impactedIds.Count > 0)
            query = query.Where(t => _impactedIds.Contains(t.Id));

        _filteredTransactions = query.OrderByDescending(t => t.Date).ToList();
        RebuildFilterSummaries();
        HashSet<Guid> filteredIds = _filteredTransactions.Select(t => t.Id).ToHashSet();
        _selected.RemoveWhere(item => !filteredIds.Contains(item.Id));

        if (_impactedIds.Count > 0 && _issueContext is not null)
        {
            foreach (TransactionDto tx in _filteredTransactions.Where(t => _impactedIds.Contains(t.Id)).Take(200))
            {
                _selected.Add(tx);
            }
        }
    }

    private void RebuildFilterSummaries()
    {
        _filterSummaries = _filteredTransactions
            .GroupBy(t => string.IsNullOrWhiteSpace(t.Money.Currency) ? "?" : t.Money.Currency)
            .OrderBy(g => g.Key)
            .Select(g =>
            {
                decimal income = g.Where(t => t.Category is "INCOME" or "DIVIDEND" or "INTEREST").Sum(t => t.Money.Amount);
                decimal expense = g.Where(t => t.Category is "EXPENSE" or "FEE" or "WITHHOLDING_TAX").Sum(t => t.Money.Amount);
                decimal investingPurchase = g.Where(t => t.Category == "INVESTMENT").Sum(t => t.Money.Amount);
                decimal investingSale = g.Where(t => t.Category == "DIVESTMENT").Sum(t => t.Money.Amount);
                decimal transfer = g.Where(t => t.Category == "TRANSFER").Sum(t => t.Money.Amount);
                decimal deposit = g.Where(t => t.Category == "DEPOSIT").Sum(t => t.Money.Amount);
                decimal fxOut = g.Where(t => t.Category == "FX_CONVERSION" && t.FxLeg == "Out").Sum(t => t.Money.Amount);
                decimal fxIn = g.Where(t => t.Category == "FX_CONVERSION" && t.FxLeg == "In").Sum(t => t.Money.Amount);
                return new FilterCurrencySummary
                {
                    Currency = g.Key,
                    Count = g.Count(),
                    Income = income,
                    Expense = expense,
                    InvestingPurchase = investingPurchase,
                    InvestingSale = investingSale,
                    Transfer = transfer,
                    Deposit = deposit,
                    FxOut = fxOut,
                    FxIn = fxIn,
                    OperatingNet = income - expense,
                };
            })
            .ToList();
    }

