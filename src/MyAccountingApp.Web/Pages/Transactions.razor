        string.Equals(_fxFromCurrency, _fxToCurrency, StringComparison.OrdinalIgnoreCase) ||
        _fxRate is <= 0;

    private async Task SaveFxAsync()
    {
        try
        {
            var payload = new
            {
                Date = _fxDate ?? DateTime.Today,
                FromAmount = _fxFromAmount,
                FromCurrency = _fxFromCurrency,
                ToAmount = _fxToAmount,
                ToCurrency = _fxToCurrency,
                Rate = _fxRate,
            };

            HttpResponseMessage response = await Http.PostAsJsonAsync("/api/transactions/fx", payload);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<FxCreateResponse>();
                if (result is not null)
                {
                    _showFxDialog = false;
                    Snackbar.Add("FX conversion created", Severity.Success);
                    
                    // Clear DQ id filter
                    _impactedIds.Clear();
                    _issueContext = null;
                    
                    // Set year/month from created pair date
                    DateTime createdDate = result.OutTransaction.Date;
                    _selectedYear = createdDate.Year;
                    _selectedMonth = createdDate.Month;
                    
                    // Load data and select new rows
                    await LoadDataAsync();
                    
                    // Select the newly created pair
                    _selected.Clear();
                    TransactionDto? outTx = _allTransactions.FirstOrDefault(t => t.Id == result.OutTransaction.Id);
                    TransactionDto? inTx = _allTransactions.FirstOrDefault(t => t.Id == result.InTransaction.Id);
                    if (outTx is not null) _selected.Add(outTx);
                    if (inTx is not null) _selected.Add(inTx);
                }
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to save: {Trim(error)}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

