@page "/transactions"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Transactions</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Transactions</MudText>

@if (_issueContext is not null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        <MudText Typo="Typo.body2" Class="d-inline">
            Showing <strong>@_filteredTransactions.Count</strong> impacted transaction(s) from Data Quality
            @if (!string.IsNullOrEmpty(IssueFromQuery))
            {
                <text>· @IssueFromQuery</text>
            }
        </MudText>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@ClearIssueFilter">Clear filter</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo("/data-quality"))">Back to Data Quality</MudButton>
    </MudAlert>
}

<TransactionFilters
    AvailableYears="@_availableYears"
    SelectedYear="@_selectedYear"
    SelectedYearChanged="@OnYearChanged"
    SelectedMonth="@_selectedMonth"
    SelectedMonthChanged="@OnMonthChanged"
    SelectedCategories="@_selectedCategories"
    SelectedCategoriesChanged="@OnCategoriesChanged"
    Categories="@_categories"
    SearchText="@_searchText"
    SearchTextChanged="@OnSearchChanged"
    OnInvestments="@NavigateToInvestments" />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_allTransactions.Count == 0)
{
    <MudPaper Class="pa-8 text-center" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Large" Class="mud-text-secondary" />
        <MudText Typo="Typo.h5" Class="mt-4">No transactions yet</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">Import your first CSV or create a transaction manually.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FileUpload"
                   OnClick="@(() => Navigation.NavigateTo("import"))">
            Go to Import
        </MudButton>
    </MudPaper>
}
else
{
    <TransactionTotals Summaries="@_filterSummaries" Count="@_filteredTransactions.Count" />

    @if (_selected.Count > 0)
    {
        <MudPaper Class="pa-2 mb-2 d-flex align-center" Outlined="true">
            <MudChip T="int" Color="Color.Primary" Size="Size.Small">@_selected.Count selected</MudChip>
            <MudText Typo="Typo.body2" Class="ml-2 mud-text-secondary">visible rows selected — bulk actions apply only to these</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       OnClick="@OpenBulkCategoryDialog" StartIcon="@Icons.Material.Filled.Edit">
                Change category
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" Class="ml-2"
                       OnClick="@OpenBulkDeleteDialog" StartIcon="@Icons.Material.Filled.Delete">
                Delete
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@ClearSelection" Size="Size.Small" />
        </MudPaper>
    }

    <TransactionList Transactions="@_filteredTransactions"
                     Selected="@_selected"
                     SelectedChanged="@OnSelectedChanged"
                     CounterText="@GetCounterText"
                     OnNew="@OpenCreateDialog"
                     OnFx="@OpenFxDialog"
                     OnRefresh="@LoadDataAsync"
                     OnEdit="@OpenEditDialog"
                     OnDelete="@OpenDeleteDialog" />
}

<TransactionFormDialog @bind-Visible="_showFormDialog"
                       EditingId="@_editingId"
                       EditingTransaction="@_editingTransaction"
                       Categories="@_categories"
                       SaveRequested="@SaveAsync" />

<BulkCategoryDialog @bind-Visible="_showBulkCategoryDialog"
                    SelectedCount="@_selected.Count"
                    Categories="@_categories"
                    ConfirmRequested="@ConfirmBulkCategoryAsync" />

<BulkDeleteDialog @bind-Visible="_showBulkDeleteDialog"
                  SelectedCount="@_selected.Count"
                  ConfirmRequested="@ConfirmBulkDeleteAsync" />

<FxConversionDialog @bind-Visible="_showFxDialog"
                    InitialDate="@_fxInitialDate"
                    SaveRequested="@SaveFxAsync" />

<DeleteTransactionDialog Visible="@_showDeleteDialog"
                         VisibleChanged="@OnDeleteDialogVisibleChanged"
                         Transaction="@_deletingTx"
                         ConfirmRequested="@ConfirmDeleteAsync" />

@code {
    private List<TransactionDto> _allTransactions = new();
    private List<TransactionDto> _filteredTransactions = new();
    private List<FilterCurrencySummary> _filterSummaries = new();
    private List<int> _availableYears = new();
    private bool _loading = true;

    private int? _selectedYear { get; set; }
    private int? _selectedMonth { get; set; }
    private HashSet<string> _selectedCategories = new(StringComparer.OrdinalIgnoreCase);
    private string? _searchText { get; set; }

    private static readonly string[] _categories = { "INCOME", "EXPENSE", "TRANSFER", "DEPOSIT", "DIVIDEND", "FEE", "WITHHOLDING_TAX", "INTEREST", "FX_CONVERSION", "LOAN_IN", "LOAN_OUT" };

    private bool _showFormDialog;
    private bool _showFxDialog;
    private bool _showDeleteDialog;
    private bool _showBulkCategoryDialog;
    private bool _showBulkDeleteDialog;
    private Guid? _editingId;
    private TransactionDto? _editingTransaction;
    private TransactionDto? _deletingTx;
    private HashSet<TransactionDto> _selected = new();
    private DateTime? _fxInitialDate;

    [SupplyParameterFromQuery(Name = "ids")]
    public string? IdsFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "issue")]
    public string? IssueFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "categories")]
    public string? CategoriesFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "year")]
    public int? YearFromQuery { get; set; }

    private List<Guid> _impactedIds = new();
    private string? _issueContext;

    protected override async Task OnInitializedAsync()
    {
        this.ApplyIssueFilterFromQuery();
        this.ApplyCategoriesFromQuery();
        if (this.YearFromQuery.HasValue)
        {
            _selectedYear = this.YearFromQuery.Value;
        }

        await this.LoadDataAsync();
    }

    private void ApplyCategoriesFromQuery()
    {
        if (string.IsNullOrWhiteSpace(this.CategoriesFromQuery))
        {
            return;
        }

        foreach (string raw in this.CategoriesFromQuery.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            string? category = _categories.FirstOrDefault(c => string.Equals(c, raw, StringComparison.OrdinalIgnoreCase));
            if (category is not null)
            {
                _selectedCategories.Add(category);
            }
        }
    }

    private void ApplyIssueFilterFromQuery()
    {
        this._impactedIds = new();
        this._issueContext = null;

        if (string.IsNullOrWhiteSpace(this.IdsFromQuery))
        {
            return;
        }

        List<Guid> ids = this.IdsFromQuery
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => Guid.TryParse(s, out Guid g) ? g : Guid.Empty)
            .Where(g => g != Guid.Empty)
            .ToList();

        if (ids.Count > 0)
        {
            this._impactedIds = ids;
            this._issueContext = string.IsNullOrWhiteSpace(this.IssueFromQuery) ? "impacted transactions" : this.IssueFromQuery;
        }
    }

    private void ClearIssueFilter()
    {
        this._impactedIds = new();
        this._issueContext = null;
        this._selected.Clear();
        this.ApplyFilters();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _allTransactions = await Http.GetFromJsonAsync<List<TransactionDto>>("/api/transactions") ?? new();
            _availableYears = _allTransactions
                .Select(t => t.Date.Year)
                .Distinct()
                .OrderByDescending(y => y)
                .ToList();
            _selected.Clear();
            ApplyFilters();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnYearChanged(int? year)
    {
        _selectedYear = year;
        if (!year.HasValue)
            _selectedMonth = null;

        ApplyFilters();
    }

    private void OnMonthChanged(int? month)
    {
        _selectedMonth = month;
        ApplyFilters();
    }

    private void OnCategoriesChanged(IEnumerable<string> values)
    {
        _selectedCategories = new HashSet<string>(values, StringComparer.OrdinalIgnoreCase);
        ApplyFilters();
    }

    private void OnSearchChanged(string? text)
    {
        _searchText = text;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = _allTransactions.AsEnumerable();

        if (_selectedYear.HasValue)
            query = query.Where(t => t.Date.Year == _selectedYear.Value);

        // Month only applies together with a year (no "all years for this month").
        if (_selectedYear.HasValue && _selectedMonth.HasValue)
            query = query.Where(t => t.Date.Month == _selectedMonth.Value);

        if (_selectedCategories.Count > 0)
            query = query.Where(t => _selectedCategories.Contains(t.Category));

        if (!string.IsNullOrWhiteSpace(_searchText))
            query = query.Where(t => t.Description.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

        if (_impactedIds.Count > 0)
            query = query.Where(t => _impactedIds.Contains(t.Id));

        _filteredTransactions = query.OrderByDescending(t => t.Date).ToList();
        RebuildFilterSummaries();
        HashSet<Guid> filteredIds = _filteredTransactions.Select(t => t.Id).ToHashSet();
        _selected.RemoveWhere(item => !filteredIds.Contains(item.Id));

        if (_impactedIds.Count > 0 && _issueContext is not null)
        {
            foreach (TransactionDto tx in _filteredTransactions.Where(t => _impactedIds.Contains(t.Id)).Take(200))
            {
                _selected.Add(tx);
            }
        }
    }

    private void RebuildFilterSummaries()
    {
        _filterSummaries = _filteredTransactions
            .GroupBy(t => string.IsNullOrWhiteSpace(t.Money.Currency) ? "?" : t.Money.Currency)
            .OrderBy(g => g.Key)
            .Select(g =>
            {
                decimal income = g.Where(t => t.Category is "INCOME" or "DIVIDEND" or "INTEREST").Sum(t => t.Money.Amount);
                decimal expense = g.Where(t => t.Category is "EXPENSE" or "FEE" or "WITHHOLDING_TAX").Sum(t => t.Money.Amount);
                decimal investingPurchase = g.Where(t => t.Category == "INVESTMENT").Sum(t => t.Money.Amount);
                decimal investingSale = g.Where(t => t.Category == "DIVESTMENT").Sum(t => t.Money.Amount);
                decimal transfer = g.Where(t => t.Category == "TRANSFER").Sum(t => t.Money.Amount);
                decimal deposit = g.Where(t => t.Category == "DEPOSIT").Sum(t => t.Money.Amount);
                decimal loanOut = g.Where(t => t.Category == "LOAN_OUT").Sum(t => t.Money.Amount);
                decimal loanIn = g.Where(t => t.Category == "LOAN_IN").Sum(t => t.Money.Amount);
                decimal fxOut = g.Where(t => t.Category == "FX_CONVERSION" && t.FxLeg == "Out").Sum(t => t.Money.Amount);
                decimal fxIn = g.Where(t => t.Category == "FX_CONVERSION" && t.FxLeg == "In").Sum(t => t.Money.Amount);
                return new FilterCurrencySummary(
                    g.Key,
                    g.Count(),
                    income,
                    expense,
                    investingPurchase,
                    investingSale,
                    transfer,
                    deposit,
                    loanOut,
                    loanIn,
                    fxOut,
                    fxIn,
                    income - expense);
            })
            .ToList();
    }

    private void NavigateToInvestments()
    {
        Navigation.NavigateTo(AssetTransactionDisplay.BuildInvestmentsLink(_selectedYear));
    }

    private string? GetCounterText(TransactionDto tx)
    {
        if (tx.FxPairId is null)
        {
            return null;
        }

        TransactionDto? sibling = _allTransactions.FirstOrDefault(t => t.FxPairId == tx.FxPairId && t.Id != tx.Id);
        string arrow = tx.FxLeg == "Out" ? "->" : "<-";
        string amount = sibling is null
            ? "no counterpart"
            : $"{arrow} {sibling.Money.Amount.ToString("N2")} {sibling.Money.Currency}";
        string rate = tx.FxBrokerRate is not null ? $" @ {tx.FxBrokerRate:G}" : string.Empty;
        return $"{amount}{rate}";
    }

    private void OpenCreateDialog()
    {
        _editingId = null;
        _editingTransaction = null;
        _showFormDialog = true;
    }

    private void OpenEditDialog(TransactionDto tx)
    {
        _editingId = tx.Id;
        _editingTransaction = tx;
        _showFormDialog = true;
    }

    private void OpenFxDialog()
    {
        _fxInitialDate = GetDefaultFxDate();
        _showFxDialog = true;
    }

    private DateTime GetDefaultFxDate()
    {
        // 1. Year + month from filter → 1st of that month
        if (_selectedYear.HasValue && _selectedMonth.HasValue)
        {
            return new DateTime(_selectedYear.Value, _selectedMonth.Value, 1);
        }
        
        // 2. Year only, current year → today; otherwise Jan 1 of that year
        if (_selectedYear.HasValue)
        {
            int year = _selectedYear.Value;
            if (year == DateTime.Today.Year)
            {
                return DateTime.Today;
            }
            return new DateTime(year, 1, 1);
        }
        
        // 3. Fallback: today
        return DateTime.Today;
    }

    private async Task SaveFxAsync(FxConversionValue value)
    {
        try
        {
            var payload = new
            {
                Date = value.Date,
                FromAmount = value.FromAmount,
                FromCurrency = value.FromCurrency,
                ToAmount = value.ToAmount,
                ToCurrency = value.ToCurrency,
                Rate = value.Rate,
            };

            HttpResponseMessage response = await Http.PostAsJsonAsync("/api/transactions/fx", payload);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<FxCreateResponse>();
                if (result is not null)
                {
                    _showFxDialog = false;
                    Snackbar.Add("FX conversion created", Severity.Success);
                    
                    // Clear DQ id filter
                    _impactedIds.Clear();
                    _issueContext = null;
                    
                    // Set year/month from created pair date
                    DateTime createdDate = result.OutTransaction.Date;
                    _selectedYear = createdDate.Year;
                    _selectedMonth = createdDate.Month;
                    
                    // Load data and select new rows
                    await LoadDataAsync();
                    
                    // Select the newly created pair
                    _selected.Clear();
                    TransactionDto? outTx = _allTransactions.FirstOrDefault(t => t.Id == result.OutTransaction.Id);
                    TransactionDto? inTx = _allTransactions.FirstOrDefault(t => t.Id == result.InTransaction.Id);
                    if (outTx is not null) _selected.Add(outTx);
                    if (inTx is not null) _selected.Add(inTx);
                }
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to save: {Trim(error)}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveAsync(TransactionFormValue value)
    {
        try
        {
            var payload = new
            {
                Date = value.Date,
                Description = value.Description,
                Amount = value.Amount,
                Currency = value.Currency,
                Category = value.Category,
            };

            HttpResponseMessage response;
            if (_editingId is null)
            {
                response = await Http.PostAsJsonAsync("/api/transactions", payload);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"/api/transactions/{_editingId}", payload);
            }

            if (response.IsSuccessStatusCode)
            {
                _showFormDialog = false;
                Snackbar.Add(_editingId is null ? "Transaction created" : "Transaction updated", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to save: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void ClearSelection()
    {
        _selected.Clear();
    }

    private static string Trim(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "no details";
        }

        return value.Length <= 200 ? value : value[..200] + "...";
    }

    private void OpenBulkCategoryDialog()
    {
        _showBulkCategoryDialog = true;
    }

    private async Task ConfirmBulkCategoryAsync(string category)
    {
        if (_selected.Count == 0 || string.IsNullOrWhiteSpace(category))
        {
            return;
        }

        List<TransactionDto> targets = _selected.Where(s => _filteredTransactions.Any(f => f.Id == s.Id) && s.Source != "Loan").ToList();
        if (targets.Count == 0)
        {
            Snackbar.Add("No visible rows selected", Severity.Warning);
            return;
        }

        var payload = new
        {
            ids = targets.Select(t => t.Id).ToList(),
            patch = new { category },
        };

        try
        {
            HttpResponseMessage response = await Http.PatchAsJsonAsync("/api/transactions/batch", payload);
            if (!response.IsSuccessStatusCode)
            {
                string body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Bulk update failed ({(int)response.StatusCode}): {Trim(body)}", Severity.Error);
                return;
            }

            BatchPatchResult? result = await response.Content.ReadFromJsonAsync<BatchPatchResult>();
            _showBulkCategoryDialog = false;
            _selected.Clear();

            if (result is null)
            {
                Snackbar.Add("Bulk update failed", Severity.Error);
            }
            else if (result.Failures.Count == 0)
            {
                Snackbar.Add($"{result.Updated} transaction(s) updated", Severity.Success);
            }
            else
            {
                string details = string.Join("; ", result.Failures.Select(f => f.Error));
                Snackbar.Add($"{result.Updated} updated, {result.Failures.Count} failed: {details}", Severity.Warning);
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenBulkDeleteDialog()
    {
        _showBulkDeleteDialog = true;
    }

    private async Task ConfirmBulkDeleteAsync()
    {
        if (_selected.Count == 0)
        {
            return;
        }

        List<TransactionDto> targets = _selected.Where(s => _filteredTransactions.Any(f => f.Id == s.Id) && s.Source != "Loan").ToList();
        if (targets.Count == 0)
        {
            Snackbar.Add("No visible rows selected", Severity.Warning);
            return;
        }

        var payload = new BulkDeleteRequest(targets.Select(t => t.Id).ToList());

        try
        {
            HttpResponseMessage response = await Http.PostAsJsonAsync("/api/transactions/bulk-delete", payload);
            if (!response.IsSuccessStatusCode)
            {
                string body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Bulk delete failed ({(int)response.StatusCode}): {Trim(body)}", Severity.Error);
                return;
            }

            BatchDeleteResult? result = await response.Content.ReadFromJsonAsync<BatchDeleteResult>();
            _showBulkDeleteDialog = false;
            _selected.Clear();

            if (result is null)
            {
                Snackbar.Add("Bulk delete failed", Severity.Error);
            }
            else if (result.Failures.Count == 0)
            {
                Snackbar.Add($"{result.Deleted} transaction(s) deleted", Severity.Success);
            }
            else
            {
                string details = string.Join("; ", result.Failures.Select(f => f.Error));
                Snackbar.Add($"{result.Deleted} deleted, {result.Failures.Count} failed: {details}", Severity.Warning);
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenDeleteDialog(TransactionDto tx)
    {
        _deletingTx = tx;
        _showDeleteDialog = true;
    }

    private void OnDeleteDialogVisibleChanged(bool value)
    {
        _showDeleteDialog = value;
        if (!value)
        {
            _deletingTx = null;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deletingTx is null) return;

        try
        {
            HttpResponseMessage response = await Http.DeleteAsync($"/api/transactions/{_deletingTx.Id}");
            _showDeleteDialog = false;
            _deletingTx = null;

            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                Snackbar.Add("Transaction deleted", Severity.Success);
                await LoadDataAsync();
            }
            else
            {
                string error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to delete: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OnSelectedChanged(HashSet<TransactionDto> value)
    {
        _selected = value;
    }
}