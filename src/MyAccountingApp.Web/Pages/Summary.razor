@page "/summary"
@page "/summary/{Year:int}"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.Globalization
@using System.Text
@using MyAccountingApp.Application.Services

<PageTitle>Summary</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Annual Summary</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (Year.HasValue)
{
    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="summary" Class="mb-4">Back to all years</MudButton>
    <MudText Typo="Typo.h4" GutterBottom="true">@Year.Value</MudText>

    @if (_summary != null)
    {
        <!-- 1. Operating Cash Flow -->
        <MudText Typo="Typo.subtitle1" Class="mb-2 mud-text-secondary">Operating cash flow</MudText>
        <MudCard Class="pa-6" Outlined="true">
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Income</MudText><MudText Typo="Typo.h5" Color="Color.Success">@_summary.Operating.Income.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Expenses</MudText><MudText Typo="Typo.h5" Color="Color.Error">@_summary.Operating.Expenses.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Dividends</MudText><MudText Typo="Typo.h5" Color="Color.Success">@_summary.Operating.Dividends.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Interest</MudText><MudText Typo="Typo.h5" Color="Color.Success">@_summary.Operating.InterestIncome.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Fees</MudText><MudText Typo="Typo.h5" Color="Color.Error">@_summary.Operating.Fees.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Withholding tax</MudText><MudText Typo="Typo.h5" Color="Color.Error">@_summary.Operating.WithholdingTax.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Net operating cash flow</MudText><MudText Typo="Typo.h5" Color="@OperatingNetColor">@_summary.Operating.NetOperatingCashFlow.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Bank transactions</MudText><MudText Typo="Typo.h5">@_summary.TransactionCount</MudText></MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                    Operating cash flow = income + dividends + interest − expenses − fees − withholding tax.
                    Investments, internal transfers and FX are excluded.
                </MudText>
            </MudCardContent>
        </MudCard>

        <!-- 2. Investing Cash Flow -->
        <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2 mud-text-secondary">Investing cash flow</MudText>
        <MudCard Class="pa-6" Outlined="true">
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="6" md="4">
                        <MudText Typo="Typo.subtitle2">Purchases (cash out)</MudText>
                        <MudTooltip Placement="Placement.Top">
                            <ChildContent>
                                <MudText Typo="Typo.h5" Color="Color.Error" Class="cursor-pointer" @onclick="@(() => NavigateToAssetTransactions(purchase: true))">−@_summary.Investing.Purchases.ToString("N2") €</MudText>
                            </ChildContent>
                            <TooltipContent><span>View purchases in Asset Transactions</span></TooltipContent>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="6" md="4">
                        <MudText Typo="Typo.subtitle2">Sales proceeds (cash in)</MudText>
                        <MudTooltip Placement="Placement.Top">
                            <ChildContent>
                                <MudText Typo="Typo.h5" Color="Color.Success" Class="cursor-pointer" @onclick="@(() => NavigateToAssetTransactions(purchase: false))">@_summary.Investing.Sales.ToString("N2") €</MudText>
                            </ChildContent>
                            <TooltipContent><span>View sales in Asset Transactions</span></TooltipContent>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="6" md="4"><MudText Typo="Typo.subtitle2">Net invested cash</MudText><MudText Typo="Typo.h5" Color="@InvestingNetColor">@_summary.Investing.NetInvestedCash.ToString("N2") €</MudText></MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                    Buying assets is not an operating expense. Sale proceeds are not operating income.
                    Net invested cash = sales proceeds − purchases. Gains/losses are calculated separately via FIFO.
                </MudText>
            </MudCardContent>
        </MudCard>

        <!-- 3. Internal movements -->
        <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2 mud-text-secondary">Internal movements</MudText>
        <MudCard Class="pa-6" Outlined="true">
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="6" md="4"><MudText Typo="Typo.subtitle2">Transfers out</MudText><MudText Typo="Typo.h5">@_summary.Internal.Transfers.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="4"><MudText Typo="Typo.subtitle2">Deposits in</MudText><MudText Typo="Typo.h5" Color="Color.Success">@_summary.Internal.Deposits.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="4"><MudText Typo="Typo.subtitle2">FX out (EUR)</MudText><MudText Typo="Typo.h5">@_summary.Internal.FxOut.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="4"><MudText Typo="Typo.subtitle2">FX in (EUR)</MudText><MudText Typo="Typo.h5" Color="Color.Success">@_summary.Internal.FxIn.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="4"><MudText Typo="Typo.subtitle2">FX net (EUR)</MudText><MudText Typo="Typo.h5" Color="@InternalFxNetColor">@_summary.Internal.FxNet.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="4"><MudText Typo="Typo.subtitle2">FX pairs</MudText><MudText Typo="Typo.h5">@_summary.Internal.FxPairCount (unmatched legs: @_summary.Internal.FxUnmatchedLegCount)</MudText></MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                    Transfers and deposits are same-currency internal moves. FX totals count EUR legs only — non-EUR legs appear under their currency in Transactions.
                    FX net is not income or expense.
                </MudText>
            </MudCardContent>
        </MudCard>

        <!-- 4. Portfolio activity -->
        <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2 mud-text-secondary">Portfolio activity</MudText>
        <MudCard Class="pa-6" Outlined="true">
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Purchases</MudText><MudText Typo="Typo.h5">@_summary.Investing.Purchases.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Sales</MudText><MudText Typo="Typo.h5">@_summary.Investing.Sales.ToString("N2") €</MudText></MudItem>
                    <MudItem xs="6" md="3"><MudText Typo="Typo.subtitle2">Asset transactions</MudText><MudText Typo="Typo.h5">@_summary.AssetTransactionCount</MudText></MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                    Purchases and sales are cash flows from AssetTransaction records (already shown in Investing above).
                    They are not folded into operating cash flow.
                </MudText>
            </MudCardContent>
        </MudCard>

        @if (_summary is { IncludesAssetCashFlows: false })
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">
                Cash and investment flows are reported separately: net operating cash flow only counts the cash ledger,
                and investment purchases/sales are shown above without being folded into cash expenses.
            </MudAlert>
        }

        @if (_summary.Months is { Count: > 0 })
        {
            <MudText Typo="Typo.h5" GutterBottom="true" Class="mt-8">Monthly breakdown</MudText>
            <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="_chartSeries" ChartLabels="_chartLabels" Width="100%" Height="350px" Class="mb-4" />

            <div class="d-flex align-center">
                <MudText Typo="Typo.h5" Class="mb-0">Monthly Breakdown</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="@ExportCsvAsync" StartIcon="@Icons.Material.Filled.Download">
                    Export CSV
                </MudButton>
            </div>

            <MudTable Items="@_summary.Months" Dense="true" Hover="true" Striped="true" Class="mt-4">
                <ColGroup>
                    <col style="width: 8%" />
                    <col style="width: 12%" />
                    <col style="width: 12%" />
                    <col style="width: 12%" />
                    <col style="width: 12%" />
                    <col style="width: 10%" />
                    <col style="width: 10%" />
                    <col style="width: 10%" />
                    <col style="width: 8%" />
                    <col style="width: 8%" />
                </ColGroup>
                <HeaderContent>
                    <MudTh>Month</MudTh>
                    <MudTh>Op. income</MudTh>
                    <MudTh>Op. expense</MudTh>
                    <MudTh>Op. net</MudTh>
                    <MudTh>Invest in</MudTh>
                    <MudTh>Invest out</MudTh>
                    <MudTh>Invest net</MudTh>
                    <MudTh>FX net (EUR)</MudTh>
                    <MudTh>Tx</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Month">@GetMonthName(context.Month)</MudTd>
                    <MudTd DataLabel="Op. income"><MudText Color="Color.Success">@context.Operating.Income.ToString("N2") €</MudText></MudTd>
                    <MudTd DataLabel="Op. expense"><MudText Color="Color.Error">@context.Operating.Expenses.ToString("N2") €</MudText></MudTd>
                    <MudTd DataLabel="Op. net"><MudText Color="@NetColor(context.Operating.NetOperatingCashFlow)">@context.Operating.NetOperatingCashFlow.ToString("N2") €</MudText></MudTd>
                    <MudTd DataLabel="Invest in"><MudText Color="Color.Error">−@context.Investing.Purchases.ToString("N2") €</MudText></MudTd>
                    <MudTd DataLabel="Invest out"><MudText Color="Color.Success">@context.Investing.Sales.ToString("N2") €</MudText></MudTd>
                    <MudTd DataLabel="Invest net"><MudText Color="@GetNetColor(context.Investing.NetInvestedCash)">@context.Investing.NetInvestedCash.ToString("N2") €</MudText></MudTd>
                    <MudTd DataLabel="FX net (EUR)"><MudText Color="@NetColor(context.Internal.FxNet)">@context.Internal.FxNet.ToString("N2") €</MudText></MudTd>
                    <MudTd DataLabel="Tx">@context.TransactionCount / @context.AssetTransactionCount</MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd><MudText Typo="Typo.subtitle2">Total</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.subtitle2" Color="Color.Success">@_summary.Operating.Income.ToString("N2") €</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.subtitle2" Color="Color.Error">@_summary.Operating.Expenses.ToString("N2") €</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.subtitle2" Color="@OperatingNetColor">@_summary.Operating.NetOperatingCashFlow.ToString("N2") €</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.subtitle2" Color="Color.Error">−@_summary.Investing.Purchases.ToString("N2") €</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.subtitle2" Color="Color.Success">@_summary.Investing.Sales.ToString("N2") €</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.subtitle2" Color="@GetNetColor(_summary.Investing.NetInvestedCash)">@_summary.Investing.NetInvestedCash.ToString("N2") €</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.subtitle2" Color="@InternalFxNetColor">@_summary.Internal.FxNet.ToString("N2") €</MudText></MudTd>
                    <MudTd><MudText Typo="Typo.subtitle2">@_summary.TransactionCount / @_summary.AssetTransactionCount</MudText></MudTd>
                </FooterContent>
            </MudTable>
        }
    }
}
else
{
    <MudText Typo="Typo.body1" Class="mb-6">Select a year to view details.</MudText>
    <MudGrid>
        @foreach (var s in _summaries)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="pa-4" Outlined="true" Style="cursor: pointer;" @onclick="() => NavigateToYear(s.Year)">
                    <MudCardContent>
                        <MudText Typo="Typo.h4" GutterBottom="true">@s.Year</MudText>
                        <MudText Typo="Typo.subtitle2">Operating income</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Success">@s.Operating.Income.ToString("N2") €</MudText>
                        <MudText Typo="Typo.subtitle2" Class="mt-2">Operating expense</MudText>
                        <MudText Typo="Typo.h6" Color="Color.Error">@s.Operating.Expenses.ToString("N2") €</MudText>
                        <MudText Typo="Typo.subtitle2" Class="mt-2">Operating net</MudText>
                        <MudText Typo="Typo.h6" Color="@GetNetColor(s.Operating.NetOperatingCashFlow)">@s.Operating.NetOperatingCashFlow.ToString("N2") €</MudText>
                        <MudText Typo="Typo.subtitle2" Class="mt-2">Invested net</MudText>
                        <MudText Typo="Typo.body2">@s.Investing.NetInvestedCash.ToString("N2") €</MudText>
                        <MudText Typo="Typo.subtitle2" Class="mt-2">Transactions</MudText>
                        <MudText Typo="Typo.body2">@s.TransactionCount bank / @s.AssetTransactionCount asset</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter]
    public int? Year { get; set; }

    private List<AnnualSummaryDto> _summaries = new();
    private AnnualSummaryDto? _summary;
    private bool _loading = true;
    private string? _error;
    private List<ChartSeries<double>> _chartSeries = new();
    private string[] _chartLabels = Array.Empty<string>();
    private int? _loadedYear;
    private bool _initialized;

    private Color OperatingNetColor => (_summary?.Operating.NetOperatingCashFlow ?? 0) >= 0 ? Color.Success : Color.Error;
    private Color InvestingNetColor => (_summary?.Investing.NetInvestedCash ?? 0) >= 0 ? Color.Success : Color.Error;
    private Color InternalFxNetColor => (_summary?.Internal.FxNet ?? 0) >= 0 ? Color.Success : Color.Error;
    private Color GetNetColor(decimal net) => net >= 0 ? Color.Success : Color.Error;
    private static Color NetColor(decimal net) => net >= 0 ? Color.Success : Color.Error;

    private void NavigateToYear(int year) => Navigation.NavigateTo($"/summary/{year}");

    private void NavigateToAssetTransactions(bool purchase)
    {
        if (Year.HasValue)
        {
            Navigation.NavigateTo(AssetTransactionDisplay.BuildDeepLink(Year.Value, purchase));
        }
    }

    private static string GetMonthName(int month) => CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month);

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _loadedYear == Year)
        {
            return;
        }

        _initialized = true;
        _loadedYear = Year;
        _loading = true;
        _error = null;
        _summary = null;
        _chartSeries = new List<ChartSeries<double>>();
        _chartLabels = Array.Empty<string>();

        try
        {
            _summaries = await Http.GetFromJsonAsync<List<AnnualSummaryDto>>("/api/summary") ?? new();

            if (Year.HasValue)
            {
                _summary = _summaries.FirstOrDefault(s => s.Year == Year.Value);
                if (_summary == null)
                {
                    _error = $"No data found for year {Year.Value}.";
                }
                else
                {
                    BuildChartData();
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildChartData()
    {
        if (_summary is null)
        {
            return;
        }

        double[] income = new double[12];
        double[] expenses = new double[12];

        foreach (MonthlySummaryDto month in _summary.Months ?? new())
        {
            income[month.Month - 1] = (double)month.Operating.Income;
            expenses[month.Month - 1] = (double)month.Operating.Expenses;
        }

        _chartSeries = new List<ChartSeries<double>>
        {
            new() { Name = "Operating income", Data = income },
            new() { Name = "Operating expense", Data = expenses },
        };
        _chartLabels = Enumerable.Range(1, 12).Select(GetMonthName).ToArray();
    }

    private async Task ExportCsvAsync()
    {
        if (_summary is null)
        {
            return;
        }

        StringBuilder csv = new();
        csv.AppendLine("Month,OperatingIncome,OperatingExpenses,OperatingNet,InvestPurchases,InvestSales,InvestNet,FXNet,BankTx,AssetTx");
        foreach (MonthlySummaryDto month in _summary.Months ?? new())
        {
            csv.AppendLine(string.Join(",",
                GetMonthName(month.Month),
                month.Operating.Income.ToString("F2", CultureInfo.InvariantCulture),
                month.Operating.Expenses.ToString("F2", CultureInfo.InvariantCulture),
                month.Operating.NetOperatingCashFlow.ToString("F2", CultureInfo.InvariantCulture),
                month.Investing.Purchases.ToString("F2", CultureInfo.InvariantCulture),
                month.Investing.Sales.ToString("F2", CultureInfo.InvariantCulture),
                month.Investing.NetInvestedCash.ToString("F2", CultureInfo.InvariantCulture),
                month.Internal.FxNet.ToString("F2", CultureInfo.InvariantCulture),
                month.TransactionCount,
                month.AssetTransactionCount));
        }

        await JS.InvokeVoidAsync("downloadTextFile", $"summary-{_summary.Year}.csv", csv.ToString(), "text/csv;charset=utf-8");
    }
}