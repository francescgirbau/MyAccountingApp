@page "/data-quality"
@using MyAccountingApp.Application.Services
@using MyAccountingApp.Domain.Entities
@using MyAccountingApp.Domain.Enums
@using MyAccountingApp.Domain.ValueObjects
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Data quality</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Data quality</MudText>

<MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
           OnClick="@LoadDataAsync" Disabled="@_loading" Class="mb-4">
    Re-check
</MudButton>
@if (ShowAdvancedMatching)
{
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SwapHoriz"
               OnClick="@RecalculateTransferMatchesAsync" Disabled="@_recalculating" Class="mb-4 ml-4">
        @(_recalculating ? "Calculating…" : "Recalculate transfer matches")
    </MudButton>
}
@if (HasMissingFxWarnings)
{
    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AttachMoney"
               OnClick="@SyncMissingFxAsync" Disabled="@_syncingFx" Class="mb-4 ml-4">
        @(_syncingFx ? "Fetching…" : "Fetch missing FX")
    </MudButton>
}

@if (_loading || _recalculating || _syncingFx)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (_result is { IsValid: true } && _result.Warnings.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">No data quality issues found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudGrid>
                <MudItem xs="4" md="3">
                    <MudChip T="string" Color="Color.Error" Size="Size.Medium">
                        @_result?.ErrorCount errors
                    </MudChip>
                </MudItem>
                <MudItem xs="4" md="3">
                    <MudChip T="string" Color="Color.Warning" Size="Size.Medium">
                        @WarningCount warnings
                    </MudChip>
                </MudItem>
                <MudItem xs="4" md="3">
                    <MudChip T="string" Color="Color.Info" Size="Size.Medium">
                        @InfoCount info
                    </MudChip>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTable Items="@_issues" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Striped="true">
            <HeaderContent>
                <MudTh Style="width:50px"></MudTh>
                <MudTh>Severity</MudTh>
                <MudTh>Code</MudTh>
                <MudTh>Message</MudTh>
                <MudTh>Impacted</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @if (context.Field == "DUPLICATE_FINGERPRINT")
                    {
                        <MudCheckBox T="bool"
                                     Value="@(_selectedDuplicateIssues.Contains(context))"
                                     ValueChanged="@((bool val) => ToggleSelection(context, val))"
                                     Size="Size.Small" Color="Color.Primary" />
                    }
                </MudTd>
                <MudTd DataLabel="Severity">
                    <MudChip T="string" Size="Size.Small" Color="@MapSeverityColor(context.Severity)">@context.Severity</MudChip>
                </MudTd>
                <MudTd DataLabel="Code"><MudText Typo="Typo.body2" Style="font-family: monospace">@context.Field</MudText></MudTd>
                <MudTd DataLabel="Message">@context.Message</MudTd>
                <MudTd DataLabel="Impacted">
                    @if (!string.IsNullOrEmpty(context.DeepLink))
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => Navigation.NavigateTo(context.DeepLink!))"
                                   StartIcon="@Icons.Material.Filled.OpenInNew">
                            View @(context.EntityIds is { Count: > 0 } ids ? $"{ids.Count} {(ids.Count == 1 ? "transaction" : "transactions")}" : "movements")
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                    }
                    @if (context.Field == "DUPLICATE_FINGERPRINT")
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Success" Size="Size.Small"
                                   OnClick="@(() => OpenResolveAsync(context))"
                                   StartIcon="@Icons.Material.Filled.CleaningServices">
                            Resolve
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">No issues.</MudText>
            </NoRecordsContent>
        </MudTable>

        @if (_selectedDuplicateIssues.Count > 0)
        {
            <MudPaper Class="pa-3 mt-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                    <MudText Typo="Typo.body2">
                        @_selectedDuplicateIssues.Count group(s) selected, ~@BulkDeleteCount duplicate(s) to delete
                    </MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                               OnClick="@ClearSelection">Clear</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.CleaningServices"
                               OnClick="@OpenBulkResolveAsync"
                               Disabled="@_resolving">
                        Resolve selected
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
    }
}

<MudOverlay Visible="_dialogOpen" OnClick="@CloseResolveAsync" />

<MudDialog @bind-Visible="_dialogOpen" Options="new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true }">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Resolve duplicate transactions</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
            This group of transactions shares the same date, description and amount.
            Choose the one to keep; the rest will be permanently deleted.
        </MudText>

        @if (_resolvingIssue is not null && _duplicateRows is { Count: > 0 })
        {
            <MudRadioGroup T="Guid" @bind-Value="_keeperId">
                <MudTable Items="_duplicateRows" Hover="true" Elevation="0" Outlined="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Keep</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Amount</MudTh>
                        <MudTh>Category</MudTh>
                        <MudTh>Source</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><MudRadio T="Guid" Value="@context.Id" /></MudTd>
                        <MudTd>@context.Date.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>@context.Description</MudTd>
                        <MudTd>@context.Money.Amount.ToString("0.##") @context.Money.Currency</MudTd>
                        <MudTd>@context.Category</MudTd>
                        <MudTd>
                            @if (string.IsNullOrEmpty(context.Source))
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">@context.Source</MudText>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudRadioGroup>

            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4 mb-4">
                @DupesToDelete duplicate(s) will be permanently deleted.
            </MudAlert>

            <MudForm>
                <MudCheckBox T="bool" @bind-Value="_confirmed" Label="I understand this action cannot be undone." Color="Color.Error" />
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@CloseResolveAsync" Disabled="@_resolving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   OnClick="@ConfirmResolveAsync"
                   Disabled="@(_confirmed == false || _resolving)">
            @(_resolving ? "Deleting…" : "Delete duplicates")
        </MudButton>
    </DialogActions>
</MudDialog>

<MudOverlay Visible="_bulkDialogOpen" OnClick="@CloseBulkResolveAsync" />

<MudDialog @bind-Visible="_bulkDialogOpen" Options="new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Resolve all selected duplicates</MudText>
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
            For each selected group the system will keep one transaction (the one with
            import provenance or the lowest id) and permanently delete the rest.
        </MudText>

        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            @_selectedDuplicateIssues.Count group(s) selected —
            ~@BulkDeleteCount duplicate(s) will be permanently deleted.
        </MudAlert>

        <MudForm>
            <MudCheckBox T="bool" @bind-Value="_bulkConfirmed"
                         Label="I understand this action cannot be undone."
                         Color="Color.Error" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default"
                   OnClick="@CloseBulkResolveAsync" Disabled="@_resolving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   OnClick="@ConfirmBulkResolveAsync"
                   Disabled="@(_bulkConfirmed == false || _resolving)">
            @(_resolving ? "Deleting…" : "Delete duplicates")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static bool ShowAdvancedMatching = false;

    private ValidationResponseDto? _result;
    private List<ValidationError> _issues = new();
    private bool _loading = true;
    private bool _recalculating;
    private bool _syncingFx;

    private bool _dialogOpen;
    private ValidationError? _resolvingIssue;
    private List<TransactionDto> _duplicateRows = new();
    private Guid _keeperId;
    private bool _confirmed;
    private bool _resolving;

    private List<ValidationError> _selectedDuplicateIssues = new();
    private List<BulkDuplicateGroup> _bulkGroups = new();
    private bool _bulkDialogOpen;
    private bool _bulkConfirmed;

    private int BulkDeleteCount => _bulkGroups.SelectMany(g => g.Rows.Where(r => r.Id != g.KeeperId)).Count();

    private int DupesToDelete => _keeperId == Guid.Empty ? 0 : _duplicateRows.Count(t => t.Id != _keeperId);

    private int WarningCount => _result?.Warnings.Count(w => w.Severity != "info") ?? 0;
    private int InfoCount => _result?.Warnings.Count(w => w.Severity == "info") ?? 0;

    private bool HasMissingFxWarnings => _result?.Warnings.Any(w => w.Field == "MISSING_FX") ?? false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _result = await Http.GetFromJsonAsync<ValidationResponseDto>("/api/validate");
            _issues = new List<ValidationError>();
            if (_result is not null)
            {
                _issues.AddRange(_result.Errors);
                _issues.AddRange(_result.Warnings);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenResolveAsync(ValidationError issue)
    {
        _resolvingIssue = issue;
        _duplicateRows = new List<TransactionDto>();
        _keeperId = Guid.Empty;
        _confirmed = false;

        try
        {
            List<TransactionDto> all = await Http.GetFromJsonAsync<List<TransactionDto>>("/api/transactions") ?? new List<TransactionDto>();
            HashSet<Guid> ids = (issue.EntityIds ?? new List<Guid>()).ToHashSet();
            _duplicateRows = all.Where(t => ids.Contains(t.Id)).ToList();
            _keeperId = PickDefaultKeeper(_duplicateRows);
            _dialogOpen = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load duplicates: {ex.Message}", Severity.Error);
        }
    }

    private void CloseResolveAsync()
    {
        if (_resolving)
        {
            return;
        }

        _dialogOpen = false;
        _resolvingIssue = null;
        _duplicateRows = new List<TransactionDto>();
        _keeperId = Guid.Empty;
        _confirmed = false;
    }

    private async Task ConfirmResolveAsync()
    {
        if (_resolvingIssue is null || _keeperId == Guid.Empty)
        {
            return;
        }

        _resolving = true;
        try
        {
            List<Guid> deleteIds = _duplicateRows.Where(t => t.Id != _keeperId).Select(t => t.Id).ToList();
            if (deleteIds.Count > 0)
            {
                HttpResponseMessage response = await Http.PostAsJsonAsync(
                    "/api/transactions/bulk-delete",
                    new BulkDeleteRequest { Ids = deleteIds });
                response.EnsureSuccessStatusCode();
                BulkDeleteResultDto? result = await response.Content.ReadFromJsonAsync<BulkDeleteResultDto>();
                Snackbar.Add(
                    $"Resolved: kept 1 transaction and deleted {result?.Deleted ?? 0} duplicate(s).",
                    Severity.Success);
            }
            else
            {
                Snackbar.Add("No duplicates to delete.", Severity.Info);
            }

            CloseResolveAsync();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to resolve duplicates: {ex.Message}", Severity.Error);
        }
        finally
        {
            _resolving = false;
        }
    }

    private void ToggleSelection(ValidationError issue, bool isSelected)
    {
        if (isSelected)
        {
            if (!_selectedDuplicateIssues.Contains(issue))
            {
                _selectedDuplicateIssues.Add(issue);
            }
        }
        else
        {
            _selectedDuplicateIssues.Remove(issue);
        }
    }

    private void ClearSelection()
    {
        _selectedDuplicateIssues.Clear();
        _bulkGroups = new List<BulkDuplicateGroup>();
    }

    private async Task OpenBulkResolveAsync()
    {
        if (_selectedDuplicateIssues.Count == 0)
        {
            return;
        }

        _bulkGroups = new List<BulkDuplicateGroup>();
        _bulkConfirmed = false;

        try
        {
            List<TransactionDto> all = await Http.GetFromJsonAsync<List<TransactionDto>>("/api/transactions") ?? new List<TransactionDto>();

            foreach (ValidationError issue in _selectedDuplicateIssues)
            {
                HashSet<Guid> ids = (issue.EntityIds ?? new List<Guid>()).ToHashSet();
                List<TransactionDto> rows = all.Where(t => ids.Contains(t.Id)).ToList();
                if (rows.Count == 0)
                {
                    continue;
                }

                Guid keeperId = PickDefaultKeeper(rows);
                _bulkGroups.Add(new BulkDuplicateGroup(issue, rows, keeperId));
            }

            if (_bulkGroups.Count == 0)
            {
                Snackbar.Add("Selected groups have no matching transactions.", Severity.Warning);
                return;
            }

            _bulkDialogOpen = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load duplicates: {ex.Message}", Severity.Error);
        }
    }

    private void CloseBulkResolveAsync()
    {
        if (_resolving)
        {
            return;
        }

        _bulkDialogOpen = false;
        _bulkConfirmed = false;
    }

    private async Task ConfirmBulkResolveAsync()
    {
        if (_bulkGroups.Count == 0)
        {
            return;
        }

        _resolving = true;
        try
        {
            List<Guid> deleteIds = _bulkGroups
                .SelectMany(g => g.Rows.Where(r => r.Id != g.KeeperId).Select(r => r.Id))
                .ToList();

            if (deleteIds.Count == 0)
            {
                Snackbar.Add("No duplicates to delete.", Severity.Info);
            }
            else
            {
                HttpResponseMessage response = await Http.PostAsJsonAsync(
                    "/api/transactions/bulk-delete",
                    new BulkDeleteRequest { Ids = deleteIds });
                response.EnsureSuccessStatusCode();
                BulkDeleteResultDto? result = await response.Content.ReadFromJsonAsync<BulkDeleteResultDto>();
                Snackbar.Add(
                    $"Resolved {_bulkGroups.Count} group(s): kept 1 per group and deleted {result?.Deleted ?? 0} duplicate(s).",
                    Severity.Success);
            }

            _bulkDialogOpen = false;
            ClearSelection();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to resolve duplicates: {ex.Message}", Severity.Error);
        }
        finally
        {
            _resolving = false;
        }
    }

    private static Guid PickDefaultKeeper(IReadOnlyList<TransactionDto> rows)
    {
        if (rows.Count == 0)
        {
            return Guid.Empty;
        }

        Transaction keeper = DuplicateResolutionService.PickDefaultKeeper(rows.Select(ToDomainTransaction).ToList());
        return keeper.Id;
    }

    private static Transaction ToDomainTransaction(TransactionDto dto)
    {
        TransactionCategory category = Enum.TryParse<TransactionCategory>(dto.Category, ignoreCase: true, out TransactionCategory parsed)
            ? parsed
            : TransactionCategory.EXPENSE;

        return new Transaction(
            dto.Id,
            dto.Date,
            dto.Description,
            new Money(dto.Money.Amount, dto.Money.Currency),
            category,
            dto.Source);
    }

    private async Task RecalculateTransferMatchesAsync()
    {
        _recalculating = true;
        try
        {
            HttpResponseMessage response = await Http.PostAsync("/api/data-quality/transfer-matches/recalculate", null);
            response.EnsureSuccessStatusCode();
            TransferMatchingResultDto? result = await response.Content.ReadFromJsonAsync<TransferMatchingResultDto>();
            if (result is not null)
            {
                Snackbar.Add(
                    $"Recalculated: {result.MatchedPairs} matched pairs, {result.ChangedTransactions} transactions changed, {result.UnmatchedTransfers} unmatched.",
                    Severity.Info);
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to recalculate transfer matches: {ex.Message}", Severity.Error);
        }
        finally
        {
            _recalculating = false;
        }
    }

    private async Task SyncMissingFxAsync()
    {
        _syncingFx = true;
        try
        {
            HttpResponseMessage response = await Http.PostAsync("/api/data-quality/sync-missing-fx", null);
            response.EnsureSuccessStatusCode();
            SyncMissingFxResult? result = await response.Content.ReadFromJsonAsync<SyncMissingFxResult>();
            if (result is not null)
            {
                Snackbar.Add(
                    result.RequestedDates == 0
                        ? "No missing FX dates found."
                        : $"FX fetched for {result.SyncedDates} of {result.RequestedDates} missing date(s).",
                    Severity.Info);
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to sync missing FX: {ex.Message}", Severity.Error);
        }
        finally
        {
            _syncingFx = false;
        }
    }

    private sealed class SyncMissingFxResult
    {
        public int RequestedDates { get; set; }
        public int SyncedDates { get; set; }
    }

    private sealed record BulkDuplicateGroup(
        ValidationError Issue,
        List<TransactionDto> Rows,
        Guid KeeperId);

    private static Color MapSeverityColor(string severity) => severity switch
    {
        "error" => Color.Error,
        "warning" => Color.Warning,
        "info" => Color.Info,
        _ => Color.Default,
    };
}
