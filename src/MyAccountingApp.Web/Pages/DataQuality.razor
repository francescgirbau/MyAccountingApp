@page "/data-quality"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Data quality</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Data quality</MudText>

<MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
           OnClick="@LoadDataAsync" Disabled="@_loading" Class="mb-4">
    Re-check
</MudButton>
@if (ShowAdvancedMatching)
{
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SwapHoriz"
               OnClick="@RecalculateTransferMatchesAsync" Disabled="@_recalculating" Class="mb-4 ml-4">
        @(_recalculating ? "Calculating…" : "Recalculate transfer matches")
    </MudButton>
}
@if (HasMissingFxWarnings)
{
    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AttachMoney"
               OnClick="@SyncMissingFxAsync" Disabled="@_syncingFx" Class="mb-4 ml-4">
        @(_syncingFx ? "Fetching…" : "Fetch missing FX")
    </MudButton>
}

@if (_loading || _recalculating || _syncingFx)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (_result is { IsValid: true } && _result.Warnings.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">No data quality issues found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudGrid>
                <MudItem xs="4" md="3">
                    <MudChip T="string" Color="Color.Error" Size="Size.Medium">
                        @_result?.ErrorCount errors
                    </MudChip>
                </MudItem>
                <MudItem xs="4" md="3">
                    <MudChip T="string" Color="Color.Warning" Size="Size.Medium">
                        @WarningCount warnings
                    </MudChip>
                </MudItem>
                <MudItem xs="4" md="3">
                    <MudChip T="string" Color="Color.Info" Size="Size.Medium">
                        @InfoCount info
                    </MudChip>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTable Items="@_issues" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Outlined="true" Striped="true">
            <HeaderContent>
                <MudTh>Severity</MudTh>
                <MudTh>Code</MudTh>
                <MudTh>Message</MudTh>
                <MudTh>Impacted</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Severity">
                    <MudChip T="string" Size="Size.Small" Color="@MapSeverityColor(context.Severity)">@context.Severity</MudChip>
                </MudTd>
                <MudTd DataLabel="Code"><MudText Typo="Typo.body2" Style="font-family: monospace">@context.Field</MudText></MudTd>
                <MudTd DataLabel="Message">@context.Message</MudTd>
                <MudTd DataLabel="Impacted">
                    @if (!string.IsNullOrEmpty(context.DeepLink))
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => Navigation.NavigateTo(context.DeepLink!))"
                                   StartIcon="@Icons.Material.Filled.OpenInNew">
                            View @(context.EntityIds is { Count: > 0 } ids ? $"{ids.Count} {(ids.Count == 1 ? "transaction" : "transactions")}" : "movements")
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">No issues.</MudText>
            </NoRecordsContent>
        </MudTable>
    }
}

@code {
    private static bool ShowAdvancedMatching = false;

    private ValidationResponseDto? _result;
    private List<ValidationError> _issues = new();
    private bool _loading = true;
    private bool _recalculating;
    private bool _syncingFx;

    private int WarningCount => _result?.Warnings.Count(w => w.Severity != "info") ?? 0;
    private int InfoCount => _result?.Warnings.Count(w => w.Severity == "info") ?? 0;

    private bool HasMissingFxWarnings => _result?.Warnings.Any(w => w.Field == "MISSING_FX") ?? false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _result = await Http.GetFromJsonAsync<ValidationResponseDto>("/api/validate");
            _issues = new List<ValidationError>();
            if (_result is not null)
            {
                _issues.AddRange(_result.Errors);
                _issues.AddRange(_result.Warnings);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RecalculateTransferMatchesAsync()
    {
        _recalculating = true;
        try
        {
            HttpResponseMessage response = await Http.PostAsync("/api/data-quality/transfer-matches/recalculate", null);
            response.EnsureSuccessStatusCode();
            TransferMatchingResultDto? result = await response.Content.ReadFromJsonAsync<TransferMatchingResultDto>();
            if (result is not null)
            {
                Snackbar.Add(
                    $"Recalculated: {result.MatchedPairs} matched pairs, {result.ChangedTransactions} transactions changed, {result.UnmatchedTransfers} unmatched.",
                    Severity.Info);
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to recalculate transfer matches: {ex.Message}", Severity.Error);
        }
        finally
        {
            _recalculating = false;
        }
    }

    private async Task SyncMissingFxAsync()
    {
        _syncingFx = true;
        try
        {
            HttpResponseMessage response = await Http.PostAsync("/api/data-quality/sync-missing-fx", null);
            response.EnsureSuccessStatusCode();
            SyncMissingFxResult? result = await response.Content.ReadFromJsonAsync<SyncMissingFxResult>();
            if (result is not null)
            {
                Snackbar.Add(
                    result.RequestedDates == 0
                        ? "No missing FX dates found."
                        : $"FX fetched for {result.SyncedDates} of {result.RequestedDates} missing date(s).",
                    Severity.Info);
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to sync missing FX: {ex.Message}", Severity.Error);
        }
        finally
        {
            _syncingFx = false;
        }
    }

    private sealed class SyncMissingFxResult
    {
        public int RequestedDates { get; set; }
        public int SyncedDates { get; set; }
    }

    private static Color MapSeverityColor(string severity) => severity switch
    {
        "error" => Color.Error,
        "warning" => Color.Warning,
        "info" => Color.Info,
        _ => Color.Default,
    };
}
