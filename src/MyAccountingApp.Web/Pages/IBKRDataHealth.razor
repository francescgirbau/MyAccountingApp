@page "/ibkr-data-health"
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>IBKR data health</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">IBKR data health</MudText>

<MudText Class="mb-4">
    Read-only diagnostic of the data imported from Interactive Brokers statements. It shows how much of
    the store comes from IBKR files (per year and per source file), option contracts whose expiration is
    in the past but that the tracker reports as open (their closing leg is missing from a legacy import),
    and candidate phantom asset rows produced by legacy imports.
</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_report is null)
{
    <MudAlert Severity="Severity.Error">Failed to load the IBKR data health report.</MudAlert>
}
else
{
    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Outlined="true"><MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Transactions (all / IBKR)</MudText>
                <MudText Typo="Typo.h5">@_report.TotalTransactions / @_report.IbkrTransactions</MudText>
            </MudCardContent></MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Outlined="true"><MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Asset transactions (all / IBKR)</MudText>
                <MudText Typo="Typo.h5">@_report.TotalAssets / @_report.IbkrAssets</MudText>
            </MudCardContent></MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Outlined="true"><MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Option transactions (all / IBKR)</MudText>
                <MudText Typo="Typo.h5">@_report.TotalOptions / @_report.IbkrOptions</MudText>
            </MudCardContent></MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Outlined="true"><MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Expired but open / phantom assets</MudText>
                <MudText Typo="Typo.h5" Class="@(_report.OpenExpiredContracts.Count + _report.PhantomAssets.Count > 0 ? "mud-error-text" : "mud-success-text")">
                    @_report.OpenExpiredContracts.Count / @_report.PhantomAssets.Count
                </MudText>
            </MudCardContent></MudCard>
        </MudItem>
    </MudGrid>

    <MudCard Elevation="0" Outlined="true" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Summary by year</MudText>
            <MudTable Items="@_report.Years" Hover="true" Elevation="0" Outlined="false">
                <HeaderContent>
                    <MudTh>Year</MudTh>
                    <MudTh>Transactions</MudTh>
                    <MudTh>Assets</MudTh>
                    <MudTh>Options</MudTh>
                    <MudTh>IBKR transactions</MudTh>
                    <MudTh>IBKR assets</MudTh>
                    <MudTh>IBKR options</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Year">@context.Year</MudTd>
                    <MudTd DataLabel="Transactions">@context.Transactions</MudTd>
                    <MudTd DataLabel="Assets">@context.Assets</MudTd>
                    <MudTd DataLabel="Options">@context.Options</MudTd>
                    <MudTd DataLabel="IBKR transactions">@context.IbkrTransactions</MudTd>
                    <MudTd DataLabel="IBKR assets">@context.IbkrAssets</MudTd>
                    <MudTd DataLabel="IBKR options">@context.IbkrOptions</MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="0" Outlined="true" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Imported sources</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                Rows are tagged with the CSV file they came from. IBKR files start with &quot;U8997440&quot;.
            </MudText>
            <MudTable Items="@_report.Sources" Hover="true" Elevation="0" Outlined="false">
                <HeaderContent>
                    <MudTh>Source</MudTh>
                    <MudTh>Transactions</MudTh>
                    <MudTh>Assets</MudTh>
                    <MudTh>Options</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Source">@context.Source</MudTd>
                    <MudTd DataLabel="Transactions">@context.Transactions</MudTd>
                    <MudTd DataLabel="Assets">@context.Assets</MudTd>
                    <MudTd DataLabel="Options">@context.Options</MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="0" Outlined="true" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Expired options still open (missing closing leg)</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                These contracts expired but the tracker reports them open: the imported data has no closing
                leg. Legacy imports dropped zero-premium closing legs; the current parser keeps them. Option
                rows do not record a source file (a known import limitation), so they appear under
                &quot;(no source)&quot; in the sources table above.
            </MudText>
            <MudTable Items="@_report.OpenExpiredContracts" Hover="true" Elevation="0" Outlined="false">
                <HeaderContent>
                    <MudTh>Contract</MudTh>
                    <MudTh>Strategy</MudTh>
                    <MudTh>Qty</MudTh>
                    <MudTh>Expiration</MudTh>
                    <MudTh>Open</MudTh>
                    <MudTh>Legs</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Contract">@context.Description</MudTd>
                    <MudTd DataLabel="Strategy">@context.Strategy</MudTd>
                    <MudTd DataLabel="Qty">@context.Quantity.ToString("G")</MudTd>
                    <MudTd DataLabel="Expiration">@context.Expiration.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Open">@context.OpenDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Legs">@context.Legs</MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="0" Outlined="true" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Phantom asset candidates</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                Asset rows with a quantity of one that are not investments or divestments. Legacy imports
                turned some option and cash rows into stock rows; re-importing with the current parser
                removes them.
            </MudText>
            <MudTable Items="@_report.PhantomAssets" Hover="true" Elevation="0" Outlined="false">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>Symbol</MudTh>
                    <MudTh>Qty</MudTh>
                    <MudTh>Category</MudTh>
                    <MudTh>Amount</MudTh>
                    <MudTh>Currency</MudTh>
                    <MudTh>Source</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date">@context.Date.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Symbol">@context.Symbol</MudTd>
                    <MudTd DataLabel="Qty">@context.Quantity.ToString("G")</MudTd>
                    <MudTd DataLabel="Category">@context.Category</MudTd>
                    <MudTd DataLabel="Amount">@context.Amount.ToString("N2")</MudTd>
                    <MudTd DataLabel="Currency">@context.Currency</MudTd>
                    <MudTd DataLabel="Source">@context.Source</MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="0" Outlined="true" Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" GutterBottom="true">Rebuild IBKR data</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Re-imports the Interactive Brokers statements cleanly: it removes the rows imported from
                IBKR files (source starting with &quot;U8997440&quot;) for the selected years, plus option
                rows without a recorded source in those years (in this app options come only from IBKR
                statements). A backup is written to <strong>backups/</strong> before anything is removed;
                other sources and manual entries are kept. After the rebuild, re-upload your Annual
                statements from the Import page.
            </MudText>

            <div class="d-flex flex-wrap align-center gap-3 mb-3">
                @foreach (int year in _report.Years.Select(y => y.Year).OrderBy(y => y))
                {
                    <MudCheckBox T="bool"
                                 Value="@(_rebuildYears.Contains(year))"
                                 ValueChanged="@(value => this.ToggleRebuildYear(year, value))"
                                 Label="@year.ToString()" />
                }
                @if (!_report.Years.Any())
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No years with data.</MudText>
                }
            </div>

            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility"
                           Disabled="@(_rebuildYears.Count == 0 || _busy)" OnClick="@this.PreviewRebuildAsync">
                    Preview deletion
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever"
                           Disabled="@(_rebuildPreview is null || _busy)" OnClick="@(() => this._showRebuildConfirm = true)">
                    Run rebuild…
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default"
                           Disabled="@(_rebuildPreview is null || _busy)" OnClick="@this.ClearRebuildPreview">
                    Clear preview
                </MudButton>
            </div>

            @if (_rebuildPreview is not null)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-4 mb-2">
                    The rebuild would delete <strong>@_rebuildPreview.Transactions</strong> transactions,
                    <strong>@_rebuildPreview.Assets</strong> assets and
                    <strong>@_rebuildPreview.Options</strong> options
                    (<strong>@_rebuildPreview.OptionsWithoutSource</strong> of them without a recorded source).
                </MudAlert>
                <MudTable Items="@_rebuildPreview.Years" Hover="true" Elevation="0" Outlined="false" Dense="true">
                    <HeaderContent>
                        <MudTh>Year</MudTh>
                        <MudTh>Transactions</MudTh>
                        <MudTh>Assets</MudTh>
                        <MudTh>Options</MudTh>
                        <MudTh>Options (no source)</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Year">@context.Year</MudTd>
                        <MudTd DataLabel="Transactions">@context.Transactions</MudTd>
                        <MudTd DataLabel="Assets">@context.Assets</MudTd>
                        <MudTd DataLabel="Options">@context.Options</MudTd>
                        <MudTd DataLabel="Options (no source)">@context.OptionsWithoutSource</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudCardContent>
    </MudCard>

    <IBKRRebuildConfirmDialog @bind-Visible="_showRebuildConfirm"
                              SelectedYears="@(_rebuildYears.OrderBy(y => y).ToList())"
                              Preview="@_rebuildPreview"
                              ConfirmRequested="@this.RunRebuildAsync" />
}

@code {
    private IBKRDataHealthDto? _report;
    private bool _loading = true;
    private readonly HashSet<int> _rebuildYears = new();
    private IBKRRebuildPreviewDto? _rebuildPreview;
    private bool _showRebuildConfirm;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await this.LoadAsync();
    }

    private async Task LoadAsync()
    {
        this._loading = true;
        try
        {
            this._report = await this.Http.GetFromJsonAsync<IBKRDataHealthDto>("/api/ibkr/data-health");
        }
        catch
        {
            this._report = null;
        }
        finally
        {
            this._loading = false;
        }
    }

    private void ToggleRebuildYear(int year, bool selected)
    {
        if (selected)
        {
            this._rebuildYears.Add(year);
        }
        else
        {
            this._rebuildYears.Remove(year);
        }
    }

    private async Task PreviewRebuildAsync()
    {
        this._busy = true;
        try
        {
            HttpResponseMessage response = await this.Http.PostAsJsonAsync(
                "/api/ibkr/rebuild/preview",
                new { years = this._rebuildYears.OrderBy(y => y).ToArray() });
            response.EnsureSuccessStatusCode();
            this._rebuildPreview = await response.Content.ReadFromJsonAsync<IBKRRebuildPreviewDto>();
        }
        catch
        {
            this._rebuildPreview = null;
            this.Snackbar.Add("Failed to preview the rebuild.", Severity.Error);
        }
        finally
        {
            this._busy = false;
        }
    }

    private void ClearRebuildPreview()
    {
        this._rebuildPreview = null;
    }

    private async Task RunRebuildAsync()
    {
        this._showRebuildConfirm = false;
        this._busy = true;
        try
        {
            HttpResponseMessage response = await this.Http.PostAsJsonAsync(
                "/api/ibkr/rebuild",
                new { years = this._rebuildYears.OrderBy(y => y).ToArray() });
            response.EnsureSuccessStatusCode();
            IBKRRebuildResultDto? result = await response.Content.ReadFromJsonAsync<IBKRRebuildResultDto>();
            this.Snackbar.Add(
                $"Rebuild done: {result?.TransactionsDeleted ?? 0} transactions, {result?.AssetsDeleted ?? 0} assets " +
                $"and {result?.OptionsDeleted ?? 0} options removed. Backup at {result?.BackupFile}. " +
                "Re-upload your Annual statements from the Import page.",
                Severity.Success);
            this._rebuildPreview = null;
            await this.LoadAsync();
        }
        catch
        {
            this.Snackbar.Add(
                "The rebuild failed. A backup is created before any removal; restore it if needed.",
                Severity.Error);
        }
        finally
        {
            this._busy = false;
        }
    }
}